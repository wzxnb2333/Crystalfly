<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Crystalfly.App.ViewModels"
        xmlns:models="using:Crystalfly.Core.Models"
        xmlns:mv="using:MarkView.Avalonia"
        xmlns:controls="using:Crystalfly.App.Views.Controls"
        xmlns:converters="using:Avalonia.Data.Converters"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="720"
        x:Class="Crystalfly.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Classes="cfp-window"
        Classes.background-active="{Binding Settings.HasActiveBackgroundImage}"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        CanResize="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Icon="/Assets/crystalfly-icon.png"
        Title="{Binding Loc[AppName]}"
        Background="{DynamicResource CfWindowBrush}">

    <Window.Resources>
        <x:Int32 x:Key="Zero">0</x:Int32>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <Image x:Name="ClientBackgroundImage"
               Grid.RowSpan="3"
               Source="{Binding Settings.ActiveBackgroundImage}"
               Opacity="{Binding Settings.ActiveBackgroundOpacity}"
               Stretch="UniformToFill"
               IsVisible="{Binding Settings.HasActiveBackgroundImage}"
               IsHitTestVisible="False" />
        <Border Grid.Row="0"
                Classes="cfp-topbar"
                PointerPressed="OnWindowChromePointerPressed">
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="24">
                <TextBlock Grid.Column="0" Classes="cfp-brand" Text="{Binding Loc[AppName]}" />

                <Border Grid.Column="1" Classes="cfp-nav-group" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding CanNavigate}">
                    <Button Classes="cfp-nav"
                            Classes.active="{Binding IsLaunchPage}"
                            Command="{Binding SelectPageCommand}"
                            CommandParameter="Launch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="Power" Size="16" />
                            <TextBlock Text="{Binding Loc[NavLaunch]}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="cfp-nav"
                            Classes.active="{Binding IsSpeedrunPage}"
                            Command="{Binding SelectPageCommand}"
                            CommandParameter="Speedrun">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="Timer" Size="16" />
                            <TextBlock Text="{Binding Loc[NavSpeedrun]}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="cfp-nav"
                            Classes.active="{Binding IsDownloadsPage}"
                            Command="{Binding SelectPageCommand}"
                            CommandParameter="Downloads">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="Download" Size="16" />
                            <TextBlock Text="{Binding Loc[NavDownloads]}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="cfp-nav"
                            Classes.active="{Binding IsSettingsPage}"
                            Command="{Binding SelectPageCommand}"
                            CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="Settings" Size="16" />
                            <TextBlock Text="{Binding Loc[NavSettings]}" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Right">
                    <Button Classes="cfp-window-button cfp-window-minimize"
                            Click="OnWindowMinimizeClick"
                            ToolTip.Tip="{Binding Loc[WindowMinimize]}"
                            AutomationProperties.Name="{Binding Loc[WindowMinimize]}"
                            Content="{LucideIconContent Minus, 16}" />
                    <Button Classes="cfp-window-button cfp-window-maximize"
                            Click="OnWindowMaximizeClick"
                            ToolTip.Tip="{Binding Loc[WindowMaximize]}"
                            AutomationProperties.Name="{Binding Loc[WindowMaximize]}"
                            Content="{LucideIconContent Maximize2, 16}" />
                    <Button Classes="cfp-window-button cfp-window-close"
                            Click="OnWindowCloseClick"
                            ToolTip.Tip="{Binding Loc[WindowClose]}"
                            AutomationProperties.Name="{Binding Loc[WindowClose]}"
                            Content="{LucideIconContent X, 16}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6">
            <Border Classes="cfp-error"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource CfErrorBrush}"
                           TextWrapping="Wrap" />
            </Border>
            <Border Classes="cfp-speedrun-reminder"
                    Classes.error="{Binding SpeedrunReminderIsError}"
                    IsVisible="{Binding HasSpeedrunReminder}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <LucideIcon Kind="Timer"
                                Size="16"
                                Foreground="{DynamicResource CfWarningBrush}"
                                VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Classes="cfp-meta"
                               Text="{Binding SpeedrunReminderText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Classes="cfp-link"
                            Command="{Binding SelectPageCommand}"
                            CommandParameter="Speedrun"
                            Content="{Binding Loc[ViewDetails]}"
                            AutomationProperties.Name="{Binding Loc[ViewDetails]}" />
                    <Button Grid.Column="3"
                            Classes="cfp-icon"
                            Margin="4,0,0,0"
                            Command="{Binding DismissSpeedrunReminderCommand}"
                            ToolTip.Tip="{Binding Loc[WindowClose]}"
                            AutomationProperties.Name="{Binding Loc[WindowClose]}"
                            Content="{LucideIconContent X, 14}" />
                </Grid>
            </Border>
        </StackPanel>

        <u:LoadingContainer Name="GlobalLoadingHost"
                            Grid.Row="2"
                            IsLoading="{Binding IsBusy}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
            <u:LoadingContainer.Indicator>
                <Grid Width="360" Height="112" RowDefinitions="20,72,20">
                    <Border Name="GlobalKnightLoadingViewport"
                            Grid.Row="1"
                            Width="45"
                            Height="72"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Image Name="GlobalKnightWalkImage"
                               Width="180"
                               Height="72"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Source="/Assets/knight-walk.png" />
                    </Border>
                    <TextBlock Name="GlobalLoadingMessage"
                               Grid.Row="2"
                               Classes="cfp-meta"
                               Text="{Binding StatusMessage}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </u:LoadingContainer.Indicator>
        <Grid>
            <!-- Launch -->
            <Grid Classes="cfp-page" IsVisible="{Binding IsLaunchPage}" ColumnDefinitions="224,*">
                <Border Grid.ColumnSpan="2"
                        Classes="cfp-launch-issue-frame"
                        IsHitTestVisible="False"
                        IsVisible="{Binding HasLaunchIssues}"
                        ZIndex="100" />
                <Border Grid.Column="0" Classes="cfp-rail" Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Row="0" Spacing="12" HorizontalAlignment="Stretch">
                            <Image Width="64"
                                   Height="64"
                                   HorizontalAlignment="Center"
                                   Source="/Assets/knight-icon.png" />
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Classes="cfp-page-title"
                                           Text="{Binding SelectedInstance.Name}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="cfp-meta"
                                           Text="{Binding SelectedInstance.DisplayVersion}"
                                           TextAlignment="Center" />
                            </StackPanel>
                            <Border Classes="cfp-badge" HorizontalAlignment="Center" IsVisible="{Binding HasInstance}">
                                <TextBlock Text="{Binding SelectedInstance.LoaderDisplay}"
                                           Foreground="{DynamicResource CfAccentTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           MaxWidth="184"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Classes="cfp-meta"
                                       Text="{Binding Loc[NoInstance]}"
                                       TextAlignment="Center"
                                       IsVisible="{Binding HasInstance, Converter={x:Static converters:BoolConverters.Not}}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="8">
                            <Button Classes="cfp-primary"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Click="ConfirmLaunch" MinHeight="44" FontSize="14" FontWeight="SemiBold"
                                     IsEnabled="{Binding CanAttemptLaunch}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <LucideIcon Kind="Play" Size="16" />
                                    <TextBlock Text="{Binding Loc[LaunchGame]}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="cfp-secondary"
                                      MinHeight="40"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center"
                                      Command="{Binding SelectPageCommand}"
                                      CommandParameter="Versions"
                                      Content="{Binding Loc[SelectInstance]}" />
                            <Button Classes="cfp-secondary"
                                    MinHeight="40"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding OpenInstanceSettingsCommand}"
                                    CommandParameter="{Binding SelectedInstance}"
                                    IsEnabled="{Binding HasInstance}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <LucideIcon Kind="Settings" Size="16" />
                                    <TextBlock Text="{Binding Loc[ManageInstance]}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Classes="cfp-workspace"
                                Margin="24"
                                Spacing="16"
                                MaxWidth="1920"
                                HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="cfp-page-title" Text="{Binding LaunchReadinessTitle}" />
                                <TextBlock Classes="cfp-meta" Text="{Binding LaunchReadinessHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="cfp-secondary"
                                        Click="ShowLaunchIssues"
                                        IsVisible="{Binding HasLaunchIssues}"
                                        AutomationProperties.Name="{Binding Loc[LaunchIssues]}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <LucideIcon Kind="TriangleAlert" Size="15" Foreground="{DynamicResource CfErrorBrush}" />
                                        <TextBlock Text="{Binding LaunchIssueCountText}"
                                                   Foreground="{DynamicResource CfErrorBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Border Classes="cfp-badge">
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Foreground="{DynamicResource CfAccentTextBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Classes="cfp-card cfp-accent-frame"
                                IsVisible="{Binding ShouldShowLaunchOnboarding}"
                                Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <LucideIcon Kind="GraduationCap" Size="16" Foreground="{DynamicResource CfAccentBrush}" />
                                        <TextBlock Grid.Column="1" Classes="cfp-row-title" Text="{Binding Loc[OnboardingLaunchCardTitle]}" />
                                    </Grid>
                                    <TextBlock Classes="cfp-caption" Text="{Binding OnboardingProgressText}" />
                                    <TextBlock Classes="cfp-meta" Text="{Binding OnboardingNextTaskTitle}" TextWrapping="Wrap" />
                                    <TextBlock Classes="cfp-caption" Text="{Binding OnboardingNextTaskDescription}" TextWrapping="Wrap" MaxLines="2" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="cfp-primary"
                                            Command="{Binding RunOnboardingNextActionCommand}"
                                            IsVisible="{Binding HasOnboardingAction}"
                                            Content="{Binding OnboardingNextActionText}"
                                            AutomationProperties.Name="{Binding OnboardingNextActionText}" />
                                    <Button Classes="cfp-secondary"
                                            Command="{Binding ShowOnboardingCommand}"
                                            Content="{Binding Loc[OnboardingContinue]}"
                                            AutomationProperties.Name="{Binding Loc[OnboardingContinue]}" />
                                    <Button Classes="cfp-link"
                                            Command="{Binding CompleteOnboardingFromUiCommand}"
                                            Content="{Binding Loc[OnboardingDismiss]}"
                                            AutomationProperties.Name="{Binding Loc[OnboardingDismiss]}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ProgressBar Name="InstanceDetailsLoading"
                                     Height="2"
                                     IsIndeterminate="True"
                                     IsVisible="{Binding IsLoadingInstanceDetails}" />
                        <Border Classes="cfp-card" IsVisible="{Binding HasInstance}">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding SelectedInstance.Name}" />
                                        <TextBlock Classes="cfp-meta" Text="{Binding SelectedInstance.RootPath}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="cfp-secondary"
                                            Click="ShowLaunchIssues"
                                            IsVisible="{Binding HasLaunchIssues}"
                                            Content="{Binding Loc[ViewDetails]}" />
                                </Grid>

                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Classes="cfp-row-title" Text="{Binding SelectedInstance.DisplayVersion}" />
                                    <TextBlock Margin="8,0" Text="·" />
                                    <TextBlock Text="{Binding SelectedInstance.LoaderDisplay}" TextWrapping="Wrap" />
                                    <TextBlock Margin="8,0" Text="·" />
                                    <TextBlock Margin="0,0,8,0" Text="{Binding SelectedInstance.ModCount}" />
                                    <TextBlock Text="{Binding Loc[ModsUnit]}" />
                                </WrapPanel>

                                <StackPanel>
                                    <Border Classes="cfp-divider-row">
                                        <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="8">
                                            <Grid Grid.Column="0">
                                                <LucideIcon Kind="CircleCheck" Size="16" IsVisible="{Binding LaunchPreflight.GameFilesReady}" />
                                                <LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource CfErrorBrush}"
                                                            IsVisible="{Binding LaunchPreflight.GameFilesReady, Converter={x:Static converters:BoolConverters.Not}}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Loc[GameFiles]}" FontWeight="Medium" />
                                            <TextBlock Grid.Column="2" Classes="cfp-meta" Text="{Binding GameFilesStatus}" />
                                        </Grid>
                                    </Border>
                                    <Border Classes="cfp-divider-row">
                                        <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="8">
                                            <Grid Grid.Column="0">
                                                <LucideIcon Kind="CircleCheck" Size="16" IsVisible="{Binding LaunchPreflight.LoaderReady}" />
                                                <LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource CfErrorBrush}"
                                                            IsVisible="{Binding LaunchPreflight.LoaderReady, Converter={x:Static converters:BoolConverters.Not}}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Loc[LoaderStatus]}" FontWeight="Medium" />
                                            <TextBlock Grid.Column="2" Classes="cfp-meta" Text="{Binding LoaderPreflightStatus}" />
                                        </Grid>
                                    </Border>
                                    <Border Classes="cfp-divider-row">
                                        <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="8">
                                            <Grid Grid.Column="0">
                                                <LucideIcon Kind="CircleCheck" Size="16" IsVisible="{Binding LaunchPreflight.DependenciesReady}" />
                                                <LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource CfErrorBrush}"
                                                            IsVisible="{Binding LaunchPreflight.DependenciesReady, Converter={x:Static converters:BoolConverters.Not}}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Loc[ModDependencies]}" FontWeight="Medium" />
                                            <TextBlock Grid.Column="2" Classes="cfp-meta" Text="{Binding ModDependencyStatus}" />
                                        </Grid>
                                    </Border>
                                    <Border Padding="12,10">
                                        <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="8">
                                            <Grid Grid.Column="0">
                                                <LucideIcon Kind="CircleCheck" Size="16" IsVisible="{Binding LaunchPreflight.SaveIsolationReady}" />
                                                <LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource CfErrorBrush}"
                                                            IsVisible="{Binding LaunchPreflight.SaveIsolationReady, Converter={x:Static converters:BoolConverters.Not}}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Loc[SaveIsolation]}" FontWeight="Medium" />
                                            <TextBlock Grid.Column="2" Classes="cfp-meta" Text="{Binding SaveIsolationStatus}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="cfp-meta"
                                   Text="{Binding Loc[ChooseRoot]}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasInstance, Converter={x:Static converters:BoolConverters.Not}}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Versions -->
            <Grid Classes="cfp-page" IsVisible="{Binding IsVersionsPage}">
                <Grid Classes="cfp-game-directory-workspace" ColumnDefinitions="280,*">
                    <Border Grid.Column="0" Classes="cfp-rail" Padding="8,16">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                            <StackPanel Spacing="4" Margin="8,0">
                                <TextBlock Classes="cfp-section-title" Text="{Binding Loc[GameDirectories]}" />
                                <TextBlock Classes="cfp-caption" Text="{Binding Loc[GameDirectoriesHint]}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ListBox Grid.Row="1"
                                     Classes="cfp-game-directory-list"
                                     ItemsSource="{Binding Instances.GameDirectories}"
                                     SelectedItem="{Binding Instances.SelectedGameDirectory, Mode=TwoWay}"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameDirectoryItemViewModel">
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="8" Margin="4,5">
                                            <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                <LucideIcon Kind="Folder" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsSteam, Converter={x:Static converters:BoolConverters.Not}}" />
                                                <LucideIcon Kind="Gamepad2" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsSteam}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Classes="cfp-row-title" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="cfp-caption" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Classes="cfp-meta" Text="{Binding InstanceCount}" />
                                                    <TextBlock Classes="cfp-meta" Margin="4,0,10,0" Text="{Binding #Root.DataContext.Loc[Instances]}" />
                                                    <TextBlock Classes="cfp-meta" Text="{Binding ScanStatus}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                <Button Classes="cfp-secondary" Click="AddCustomGameDirectory" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="FolderPlus" Size="15" /><TextBlock Text="{Binding Loc[AddGameDirectory]}" /></StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="cfp-icon" Command="{Binding Instances.RefreshGameDirectoriesCommand}" ToolTip.Tip="{Binding Loc[RefreshGameDirectories]}" AutomationProperties.Name="{Binding Loc[RefreshGameDirectories]}" Content="{LucideIconContent RefreshCw, 15}" />
                                <Button Grid.Column="2" Classes="cfp-icon" Command="{Binding Instances.RemoveSelectedGameDirectoryCommand}" ToolTip.Tip="{Binding Loc[RemoveGameDirectory]}" AutomationProperties.Name="{Binding Loc[RemoveGameDirectory]}" Content="{LucideIconContent Trash2, 15}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="cfp-workspace" Margin="24" Spacing="16" MaxWidth="1600" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="cfp-section-title" Text="{Binding Loc[SelectInstance]}" />
                                <TextBlock Classes="cfp-meta" Text="{Binding Loc[InstancesHint]}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Classes="cfp-input" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{Binding Loc[SearchInstances]}" AutomationProperties.Name="{Binding Loc[SearchInstances]}" IsVisible="{Binding Instances.GameDirectories.Count, Converter={x:Static converters:ObjectConverters.NotEqual}, ConverterParameter={StaticResource Zero}}" />
                            <Border Classes="cfp-list-frame" IsVisible="{Binding Instances.GameDirectories.Count, Converter={x:Static converters:ObjectConverters.NotEqual}, ConverterParameter={StaticResource Zero}}">
                                <Grid>
                                    <ListBox Classes="cfp-list cfp-instance-list" ItemsSource="{Binding Instances.VisibleInstances}" SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InstanceItemViewModel">
                                                <Grid Classes="cfp-instance-row" ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                    <Button Grid.ColumnSpan="2" Classes="cfp-instance-main" Command="{Binding #Root.DataContext.Instances.SelectInstanceForLaunchCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                    <Grid Grid.Column="0" Classes="cfp-instance-summary" ColumnDefinitions="44,*" ColumnSpacing="12" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                        <Border Width="40" Height="40" CornerRadius="10" Classes="cfp-icon-tile">
                                                            <LucideIcon Kind="Box" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Classes="cfp-row-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <LucideIcon Kind="Star" Size="14" Foreground="{DynamicResource CfAccentBrush}" IsVisible="{Binding IsFavorite}" />
                                                            </StackPanel>
                                                            <WrapPanel Orientation="Horizontal">
                                                                <TextBlock Classes="cfp-meta" Text="{Binding DisplayVersion}" />
                                                                <TextBlock Classes="cfp-meta" Margin="8,0" Text="{Binding LoaderDisplay}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="cfp-meta" Margin="0,0,4,0" Text="{Binding ModCount}" />
                                                                <TextBlock Classes="cfp-meta" Text="{Binding #Root.DataContext.Loc[ModsUnit]}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Classes="cfp-instance-actions" Orientation="Horizontal" Spacing="2" Width="126" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Classes="cfp-instance-action" Classes.active="{Binding IsFavorite}" Command="{Binding #Root.DataContext.Instances.ToggleFavoriteInstanceCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding #Root.DataContext.Loc[FavoriteInstance]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[FavoriteInstance]}" Content="{LucideIconContent Star, 15}" />
                                                        <Button Classes="cfp-instance-action" Click="ConfirmDeleteInstance" ToolTip.Tip="{Binding #Root.DataContext.Loc[DeleteInstance]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[DeleteInstance]}" Content="{LucideIconContent Trash2, 15}" />
                                                        <Button Classes="cfp-instance-action" Click="CloneInstanceWithName" ToolTip.Tip="{Binding #Root.DataContext.Loc[CloneInstance]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[CloneInstance]}" Content="{LucideIconContent Copy, 15}" />
                                                        <Button Classes="cfp-instance-action" Command="{Binding #Root.DataContext.OpenInstanceSettingsCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding #Root.DataContext.Loc[ManageInstance]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[ManageInstance]}" Content="{LucideIconContent Settings, 15}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel MinHeight="120" Margin="24" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Instances.VisibleInstances.Count, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}">
                                        <TextBlock Classes="cfp-meta" Text="{Binding Loc[NoInstancesAction]}" TextAlignment="Center" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Button Classes="cfp-secondary" Command="{Binding Instances.RefreshGameDirectoriesCommand}" Content="{Binding Loc[RefreshGameDirectories]}" />
                                            <Button Classes="cfp-secondary" Click="AddCustomGameDirectory" Content="{Binding Loc[AddGameDirectory]}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Instances.GameDirectories.Count, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}">
                                <TextBlock Classes="cfp-meta" Text="{Binding Loc[NoGameDirectories]}" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Classes="cfp-accent" Command="{Binding Instances.RequestGameDirectoryDiscoveryCommand}" Content="{Binding Loc[ScanGameDirectories]}" />
                                <TextBlock Classes="cfp-caption"
                                           Text="{Binding Instances.GameDirectoryScanProgress}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           IsVisible="{Binding Instances.IsScanningGameDirectories}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Instance management -->
            <Grid Classes="cfp-page" IsVisible="{Binding IsManagePage}">
                <Grid ColumnDefinitions="176,*">
                    <Border Grid.Column="0" Classes="cfp-rail" Padding="8,16">
                        <StackPanel Classes="cfp-manage-nav" Spacing="4" IsEnabled="{Binding CanNavigate}">
                            <Button Classes="cfp-local-nav"
                                    Classes.active="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Overview}"
                                    Command="{Binding SelectManageTabCommand}"
                                    CommandParameter="Overview">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><LucideIcon Kind="Box" Size="16" /><TextBlock Grid.Column="1" Text="{Binding Loc[Overview]}" TextTrimming="CharacterEllipsis" /></Grid>
                            </Button>
                            <Button Classes="cfp-local-nav"
                                    Classes.active="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Loader}"
                                    Command="{Binding SelectManageTabCommand}"
                                    CommandParameter="Loader">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><LucideIcon Kind="Wrench" Size="16" /><TextBlock Grid.Column="1" Text="{Binding Loc[Loader]}" TextTrimming="CharacterEllipsis" /></Grid>
                            </Button>
                            <Button Classes="cfp-local-nav"
                                    Classes.active="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Mods}"
                                    Command="{Binding SelectManageTabCommand}"
                                    CommandParameter="Mods">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><LucideIcon Kind="PackagePlus" Size="16" /><TextBlock Grid.Column="1" Text="{Binding Loc[Mods]}" TextTrimming="CharacterEllipsis" /></Grid>
                            </Button>
                            <Button Classes="cfp-local-nav"
                                    Classes.active="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Presets}"
                                    Command="{Binding SelectManageTabCommand}"
                                    CommandParameter="Presets">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><LucideIcon Kind="ListRestart" Size="16" /><TextBlock Grid.Column="1" Text="{Binding Loc[ModPresets]}" TextTrimming="CharacterEllipsis" /></Grid>
                            </Button>
                            <Button Classes="cfp-local-nav"
                                    Classes.active="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Snapshots}"
                                    Command="{Binding SelectManageTabCommand}"
                                    CommandParameter="Snapshots">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><LucideIcon Kind="Camera" Size="16" /><TextBlock Grid.Column="1" Text="{Binding Loc[Snapshots]}" TextTrimming="CharacterEllipsis" /></Grid>
                            </Button>
                            <Button Classes="cfp-local-nav"
                                    Classes.active="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Logs}"
                                    Command="{Binding SelectManageTabCommand}"
                                    CommandParameter="Logs">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><LucideIcon Kind="ScrollText" Size="16" /><TextBlock Grid.Column="1" Text="{Binding Loc[Logs]}" TextTrimming="CharacterEllipsis" /></Grid>
                            </Button>
                            <Button Classes="cfp-local-nav"
                                    Classes.active="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Config}"
                                    Command="{Binding SelectManageTabCommand}"
                                    CommandParameter="Config">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><LucideIcon Kind="Settings2" Size="16" /><TextBlock Grid.Column="1" Text="{Binding Loc[Config]}" TextTrimming="CharacterEllipsis" /></Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Classes="cfp-workspace"
                              Margin="24"
                              MaxWidth="1920"
                              HorizontalAlignment="Stretch">
                            <StackPanel Spacing="16"
                                        Classes="cfp-tab-panel cfp-subpage"
                                        IsVisible="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Overview}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="cfp-page-title" Text="{Binding Loc[Overview]}" />
                                    <TextBlock Classes="cfp-meta" Text="{Binding SelectedInstance.RootPath}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Classes="cfp-card">
                                    <StackPanel>
                                        <Border Classes="cfp-divider-row">
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Loc[NavVersions]}" /><TextBlock Grid.Column="1" Text="{Binding SelectedInstance.DisplayVersion}" FontWeight="SemiBold" /></Grid>
                                        </Border>
                                        <Border Classes="cfp-divider-row">
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Loc[Loader]}" /><TextBlock Grid.Column="1" Text="{Binding CurrentLoaderState}" FontWeight="SemiBold" /></Grid>
                                        </Border>
                                        <Border Padding="12,10">
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Loc[Mods]}" /><TextBlock Grid.Column="1" Text="{Binding SelectedInstance.ModCount}" FontWeight="SemiBold" /></Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <Border Classes="cfp-card">
                                        <StackPanel Spacing="12">
                                            <TextBlock Classes="cfp-section-title" Text="{Binding Loc[InstanceShortcuts]}" />
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="cfp-secondary" Margin="0,0,8,8" Click="OpenSelectedInstanceFolder">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="FolderOpen" Size="16" /><TextBlock Text="{Binding Loc[InstanceFolder]}" /></StackPanel>
                                                </Button>
                                                <Button Classes="cfp-secondary" Margin="0,0,8,8" Click="OpenSelectedSaveFolder">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="ArchiveRestore" Size="16" /><TextBlock Text="{Binding Loc[SaveFolder]}" /></StackPanel>
                                                </Button>
                                                <Button Classes="cfp-secondary" Margin="0,0,0,8" Click="OpenSelectedModFolder" IsEnabled="{Binding CanOpenModFolder}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="PackageOpen" Size="16" /><TextBlock Text="{Binding Loc[ModFolder]}" /></StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="cfp-card">
                                        <StackPanel Spacing="12">
                                            <TextBlock Classes="cfp-section-title" Text="{Binding Loc[InstanceActions]}" />
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="cfp-secondary" Margin="0,0,8,8" Click="RenameSelectedInstance">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Pencil" Size="16" /><TextBlock Text="{Binding Loc[RenameInstance]}" /></StackPanel>
                                                </Button>
                                                <Button Classes="cfp-secondary" Margin="0,0,8,8" Click="ConfirmCompleteInstanceFiles">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="CircleCheck" Size="16" /><TextBlock Text="{Binding Loc[CompleteInstanceFiles]}" /></StackPanel>
                                                </Button>
                                                <Button Classes="cfp-danger" Margin="0,0,0,8" Click="ConfirmDeleteSelectedInstance">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Trash2" Size="16" /><TextBlock Text="{Binding Loc[DeleteInstance]}" /></StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="16"
                                        Classes="cfp-tab-panel cfp-subpage"
                                        IsVisible="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Loader}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="cfp-page-title" Text="{Binding Loc[Loader]}" />
                                    <TextBlock Classes="cfp-meta" Text="{Binding CurrentLoaderState}" TextWrapping="Wrap" />
                                    <TextBlock Classes="cfp-caption"
                                               Text="{Binding LoaderVerificationStatus}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding LoaderVerificationStatus, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                    <Button Classes="cfp-link" HorizontalAlignment="Left" MinHeight="36"
                                            Command="{Binding AdoptExternalContentCommand}"
                                            IsVisible="{Binding CanAdoptExternalContent}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="PackagePlus" Size="14" />
                                            <TextBlock Text="{Binding Loc[AdoptExternalContent]}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="12">
                                        <ComboBox Classes="cfp-input"
                                                  ItemsSource="{Binding AvailableLoaders}"
                                                  SelectedItem="{Binding SelectedLoader, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="{Binding Loc[Loader]}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:LoaderManifest">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Classes="cfp-meta" Text="{Binding Version}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Spacing="8"
                                                    IsVisible="{Binding AvailableLoaders.Count, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}">
                                            <TextBlock Classes="cfp-meta"
                                                       Text="{Binding Loc[NoLoadersAction]}"
                                                       TextWrapping="Wrap" />
                                            <Button Classes="cfp-secondary"
                                                    Command="{Binding RefreshCommand}"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <LucideIcon Kind="RefreshCw" Size="16" />
                                                    <TextBlock Text="{Binding Loc[Refresh]}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="cfp-accent"
                                                    Command="{Binding InstallOrSwitchLoaderCommand}"
                                                    Margin="0,0,8,8">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                                        <Binding Path="SelectedLoader" Converter="{x:Static converters:ObjectConverters.IsNotNull}" />
                                                        <Binding Path="IsBusy" Converter="{x:Static converters:BoolConverters.Not}" />
                                                        <Binding Path="IsGameRunning" Converter="{x:Static converters:BoolConverters.Not}" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <LucideIcon Kind="PackagePlus" Size="16" />
                                                    <TextBlock Text="{Binding Loc[InstallOrSwitch]}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="cfp-secondary"
                                                    Command="{Binding RepairLoaderCommand}"
                                                    Margin="0,0,8,8">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                                        <Binding Path="HasInstance" />
                                                        <Binding Path="IsBusy" Converter="{x:Static converters:BoolConverters.Not}" />
                                                        <Binding Path="IsGameRunning" Converter="{x:Static converters:BoolConverters.Not}" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <LucideIcon Kind="Wrench" Size="16" />
                                                    <TextBlock Text="{Binding Loc[Repair]}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="cfp-secondary"
                                                    Click="ConfirmUninstallLoader"
                                                    Margin="0,0,8,8">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                                        <Binding Path="HasInstance" />
                                                        <Binding Path="IsBusy" Converter="{x:Static converters:BoolConverters.Not}" />
                                                        <Binding Path="IsGameRunning" Converter="{x:Static converters:BoolConverters.Not}" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <LucideIcon Kind="Trash2" Size="16" />
                                                    <TextBlock Text="{Binding Loc[Uninstall]}" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Expander Header="{Binding Loc[AdvancedLocalLoader]}">
                                    <Border Classes="cfp-card" Margin="0,8,0,0">
                                        <StackPanel Spacing="10">
                                            <u:PathPicker UsePickerType="OpenFile"
                                                          FileFilter="[JSON,*.json]"
                                                          Title="{Binding Loc[SelectLoaderManifestTitle]}"
                                                          SelectedPathsText="{Binding LocalLoaderManifestPath, Mode=TwoWay}"
                                                          IsOmitCommandOnCancel="True"
                                                          MinHeight="44"
                                                          AutomationProperties.Name="{Binding Loc[LocalLoaderManifestPath]}">
                                                <u:PathPicker.Styles>
                                                    <Style Selector="TextBox">
                                                        <Setter Property="AutomationProperties.Name"
                                                                Value="{Binding Loc[LocalLoaderManifestPath]}" />
                                                    </Style>
                                                </u:PathPicker.Styles>
                                                <u:PathPicker.ButtonContent>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <LucideIcon Kind="FolderOpen" Size="16" />
                                                        <TextBlock Text="{Binding Loc[Browse]}" />
                                                    </StackPanel>
                                                </u:PathPicker.ButtonContent>
                                            </u:PathPicker>
                                            <Button Classes="cfp-secondary"
                                                    Command="{Binding ImportLocalLoaderCommand}"
                                                    HorizontalAlignment="Left">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                                        <Binding Path="HasInstance" />
                                                        <Binding Path="LocalLoaderManifestPath" Converter="{x:Static converters:StringConverters.IsNotNullOrEmpty}" />
                                                        <Binding Path="IsBusy" Converter="{x:Static converters:BoolConverters.Not}" />
                                                        <Binding Path="IsGameRunning" Converter="{x:Static converters:BoolConverters.Not}" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <LucideIcon Kind="ShieldAlert" Size="16" />
                                                    <TextBlock Text="{Binding Loc[ImportLocalLoader]}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>

                            <StackPanel Spacing="16"
                                        Classes="cfp-tab-panel cfp-subpage"
                                        IsVisible="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Presets}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="cfp-page-title" Text="{Binding Loc[ModPacks]}" />
                                        <TextBlock Classes="cfp-meta" Text="{Binding Loc[ModPacksHint]}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="cfp-secondary"
                                            Command="{Binding RestorePresetStateCommand}"
                                            IsEnabled="{Binding HasPresetRestorePoint}"
                                            IsVisible="{Binding HasPresetRestorePoint}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <LucideIcon Kind="Undo2" Size="16" />
                                            <TextBlock Text="{Binding Loc[RestorePresetState]}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="264,*" ColumnSpacing="16" MinHeight="380">
                                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Classes="cfp-meta" Text="{Binding Loc[LocalModPacks]}" />
                                                <TextBlock Classes="cfp-caption" Text="{Binding ModPresets.Count, StringFormat='({0})'}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="cfp-icon"
                                                    Click="ShowCreateModPackDialog"
                                                    ToolTip.Tip="{Binding Loc[CreateModPack]}"
                                                    AutomationProperties.Name="{Binding Loc[CreateModPack]}"
                                                    Content="{LucideIconContent Plus, 16}" />
                                            <Button Grid.Column="2"
                                                    Classes="cfp-icon"
                                                    Click="ImportPresetFile"
                                                    ToolTip.Tip="{Binding Loc[ImportPreset]}"
                                                    AutomationProperties.Name="{Binding Loc[ImportPreset]}"
                                                    Content="{LucideIconContent Import, 16}" />
                                        </Grid>
                                        <TextBox Grid.Row="1"
                                                 Classes="cfp-input"
                                                 Text="{Binding ModPackSearchText, Mode=TwoWay}"
                                                 PlaceholderText="{Binding Loc[SearchModPacks]}"
                                                 AutomationProperties.Name="{Binding Loc[SearchModPacks]}" />
                                        <Border Grid.Row="2" Classes="cfp-list-frame">
                                            <Grid>
                                                <ListBox Classes="cfp-list cfp-preset-list"
                                                         MinHeight="260"
                                                         ItemsSource="{Binding VisibleModPacks}"
                                                         SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ModPreset">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Classes="cfp-row-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="cfp-caption" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding GameBuildId}" />
                                                                    <Run Text=" · " />
                                                                    <Run Text="{Binding LoaderId}" />
                                                                </TextBlock>
                                                                <TextBlock Classes="cfp-caption">
                                                                    <Run Text="{Binding Entries.Count}" />
                                                                    <Run Text=" " />
                                                                    <Run Text="{Binding #Root.DataContext.Loc[Mods]}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Margin="20"
                                                           Classes="cfp-meta"
                                                           Text="{Binding Loc[NoMatchingModPacks]}"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding VisibleModPacks.Count, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}" />
                                            </Grid>
                                        </Border>
                                        <Button Grid.Row="3"
                                                Classes="cfp-secondary"
                                                HorizontalAlignment="Stretch"
                                                Click="ShowImportSharedModPackDialog">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                                <LucideIcon Kind="CloudDownload" Size="16" />
                                                <TextBlock Text="{Binding Loc[ImportSharedPreset]}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Border Classes="cfp-card cfp-accent-frame" VerticalAlignment="Top" IsVisible="{Binding HasSelectedPreset}">
                                            <StackPanel Spacing="14">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Classes="cfp-section-title" Text="{Binding SelectedPreset.Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="cfp-meta" Text="{Binding Loc[ModPackSummary]}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="cfp-accent" Click="ConfirmApplyPreset">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <LucideIcon Kind="Play" Size="16" />
                                                            <TextBlock Text="{Binding Loc[ApplyPreset]}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                                    <TextBlock Classes="cfp-caption" Text="{Binding Loc[GameBuild]}" />
                                                    <TextBlock Grid.Column="1" Classes="cfp-row-title" Text="{Binding SelectedPreset.GameBuildId}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Classes="cfp-caption" Text="{Binding Loc[Loader]}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="cfp-row-title" Text="{Binding SelectedPreset.LoaderId}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="2" Classes="cfp-caption" Text="{Binding Loc[PresetMode]}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="cfp-row-title" Text="{Binding SelectedPresetModeOption.Name}" />
                                                    <TextBlock Grid.Row="3" Classes="cfp-caption" Text="{Binding Loc[ModCount]}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="cfp-row-title" Text="{Binding SelectedPresetEntryCount}" />
                                                </Grid>
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Classes="cfp-secondary" Command="{Binding RecaptureSelectedPresetCommand}" Margin="0,0,8,8" Content="{Binding Loc[RecapturePreset]}" />
                                                    <Button Classes="cfp-secondary" Click="ExportSelectedPreset" Margin="0,0,8,8" Content="{Binding Loc[ExportPreset]}" />
                                                    <Button Classes="cfp-secondary" Click="ShareAndCopyPresetLink" Margin="0,0,8,8" Content="{Binding Loc[SharePreset]}" />
                                                    <Button Classes="cfp-secondary" Click="ShowCopyModPackDialog" Margin="0,0,8,8" Content="{Binding Loc[CopyPreset]}" />
                                                    <Button Classes="cfp-secondary danger" Click="ConfirmDeletePreset" Margin="0,0,8,8" Content="{Binding Loc[DeletePreset]}" />
                                                </WrapPanel>

                                                <Button Classes="cfp-secondary"
                                                        Command="{Binding ToggleSelectedPresetEntriesCommand}"
                                                        HorizontalAlignment="Stretch">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <LucideIcon Kind="List" Size="16" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Loc[ViewModPackContents]}" HorizontalAlignment="Left" />
                                                        <TextBlock Grid.Column="2" Classes="cfp-caption" Text="{Binding SelectedPresetEntryCount}" />
                                                    </Grid>
                                                </Button>

                                                <StackPanel Spacing="10" IsVisible="{Binding IsSelectedPresetEntriesExpanded}">
                                                    <TextBox Classes="cfp-input"
                                                             Text="{Binding ModPackEntrySearchText, Mode=TwoWay}"
                                                             PlaceholderText="{Binding Loc[SearchModPackContents]}"
                                                             AutomationProperties.Name="{Binding Loc[SearchModPackContents]}" />
                                                    <Border Classes="cfp-list-frame" MaxHeight="260">
                                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                                            <ItemsControl ItemsSource="{Binding VisibleSelectedModPackEntries}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:ModPresetEntry">
                                                                        <Grid ColumnDefinitions="*,Auto" Margin="10,7" ColumnSpacing="10">
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Classes="cfp-caption" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="1" Classes="cfp-caption" Text="{Binding Version}" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Classes="cfp-card" VerticalAlignment="Top" IsVisible="{Binding HasSelectedPreset, Converter={x:Static converters:BoolConverters.Not}}">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                                <LucideIcon Kind="PackageOpen" Size="28" HorizontalAlignment="Center" />
                                                <TextBlock Classes="cfp-section-title" Text="{Binding Loc[NoModPackSelected]}" TextAlignment="Center" />
                                                <TextBlock Classes="cfp-meta" Text="{Binding Loc[NoModPackSelectedHint]}" TextWrapping="Wrap" TextAlignment="Center" />
                                                <Button Classes="cfp-accent" Click="ShowCreateModPackDialog" Content="{Binding Loc[CreateModPack]}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="16"
                                        Classes="cfp-tab-panel cfp-subpage"
                                        IsVisible="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Snapshots}">
                                <StackPanel Spacing="16"
                                            IsVisible="{Binding IsEditingSave, Converter={x:Static converters:BoolConverters.Not}}">
                                    <TextBlock Classes="cfp-page-title" Text="{Binding Loc[Snapshots]}" />
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBox Width="240"
                                                 Classes="cfp-input"
                                                 Text="{Binding SnapshotName, Mode=TwoWay}"
                                                 PlaceholderText="{Binding Loc[SnapshotName]}"
                                                 AutomationProperties.Name="{Binding Loc[SnapshotName]}"
                                                 Margin="0,0,8,8" />
                                        <Button Classes="cfp-accent"
                                                Command="{Binding CreateSnapshotCommand}"
                                                Margin="0,0,8,8">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                                    <Binding Path="HasInstance" />
                                                    <Binding Path="SnapshotName" Converter="{x:Static converters:StringConverters.IsNotNullOrEmpty}" />
                                                    <Binding Path="IsBusy" Converter="{x:Static converters:BoolConverters.Not}" />
                                                    <Binding Path="IsGameRunning" Converter="{x:Static converters:BoolConverters.Not}" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="Camera" Size="16" />
                                                <TextBlock Text="{Binding Loc[CreateSnapshot]}" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <Button Classes="cfp-market-item"
                                            Command="{Binding EditSaveCommand}"
                                            CommandParameter="current"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            IsVisible="{Binding HasInstance}"
                                            IsEnabled="{Binding IsGameRunning, Converter={x:Static converters:BoolConverters.Not}}">
                                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                            <Border Width="32"
                                                    Height="32"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource CfAccentSoftBrush}">
                                                <LucideIcon Kind="PenLine"
                                                            Size="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Classes="cfp-row-title" Text="{Binding SelectedInstance.Name}" />
                                                <TextBlock Classes="cfp-caption" Text="{Binding Loc[CurrentSave]}" />
                                            </StackPanel>
                                            <LucideIcon Grid.Column="2"
                                                        Kind="ChevronRight"
                                                        Size="16"
                                                        Foreground="{DynamicResource CfMutedTextBrush}"
                                                        VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Border Classes="cfp-list-frame">
                                        <Grid>
                                            <ListBox Classes="cfp-list"
                                                     ItemsSource="{Binding Snapshots}"
                                                     SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:NamedSnapshot">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Classes="cfp-row-title" Text="{Binding Name}" />
                                                                <TextBlock Classes="cfp-caption" Text="{Binding Id}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Classes="cfp-meta"
                                                                       Text="{Binding CreatedAt}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="2"
                                                                    Classes="cfp-icon"
                                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditSaveCommand}"
                                                                    CommandParameter="{Binding Id}"
                                                                    VerticalAlignment="Center"
                                                                    IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsGameRunning, Converter={x:Static converters:BoolConverters.Not}}"
                                                                    ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Loc[EditSave]}"
                                                                    AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Loc[EditSave]}"
                                                                    Content="{LucideIconContent Pencil, 14}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock MinHeight="120"
                                                       Margin="24"
                                                       Classes="cfp-meta"
                                                       Text="{Binding Loc[NoSnapshotsAction]}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding Snapshots.Count, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="8">
                                        <Button Classes="cfp-secondary danger"
                                                Click="ConfirmDeleteSnapshot">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                                    <Binding Path="SelectedSnapshot" Converter="{x:Static converters:ObjectConverters.IsNotNull}" />
                                                    <Binding Path="IsBusy" Converter="{x:Static converters:BoolConverters.Not}" />
                                                    <Binding Path="IsGameRunning" Converter="{x:Static converters:BoolConverters.Not}" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="Trash2" Size="16" />
                                                <TextBlock Text="{Binding Loc[DeleteSnapshot]}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="cfp-secondary"
                                                Click="ConfirmRestoreSnapshot">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                                    <Binding Path="SelectedSnapshot" Converter="{x:Static converters:ObjectConverters.IsNotNull}" />
                                                    <Binding Path="IsBusy" Converter="{x:Static converters:BoolConverters.Not}" />
                                                    <Binding Path="IsGameRunning" Converter="{x:Static converters:BoolConverters.Not}" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="ArchiveRestore" Size="16" />
                                                <TextBlock Text="{Binding Loc[Restore]}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="12"
                                            Classes="cfp-subpage"
                                            IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsEditingSave}"
                                            DataContext="{Binding SaveEditor}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Button Classes="cfp-secondary"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ExitSaveEditorCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="ArrowLeft" Size="16" />
                                                <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Loc[Back]}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Classes="cfp-page-title"
                                                   Text="{Binding SourceLabel}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2"
                                                  Classes="cfp-input"
                                                  MinWidth="180"
                                                  ItemsSource="{Binding Slots}"
                                                  SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                                                  SelectionChanged="OnSaveSlotSelectionChanged"
                                                  AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Loc[SaveSlot]}" />
                                    </Grid>
                                    <u:LoadingContainer Name="SaveEditorLoadingHost"
                                                        MinHeight="480"
                                                        IsLoading="{Binding IsLoaded, Converter={x:Static converters:BoolConverters.Not}}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch">
                                        <u:LoadingContainer.Indicator>
                                            <Border Name="SaveEditorKnightLoadingViewport"
                                                    Width="45"
                                                    Height="72"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    ClipToBounds="True">
                                                <Image Name="SaveEditorKnightWalkImage"
                                                       Width="180"
                                                       Height="72"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Source="/Assets/knight-walk.png" />
                                            </Border>
                                        </u:LoadingContainer.Indicator>
                                        <Grid IsVisible="{Binding IsLoaded}">
                                            <Border Classes="cfp-list-frame" MaxHeight="480">
                                                <ListBox Classes="cfp-list cfp-save-entry-list"
                                                         ItemsSource="{Binding Entries}">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SaveEntryViewModel">
                                                            <Grid ColumnDefinitions="2*,3*,80"
                                                                  ColumnSpacing="8"
                                                                  Margin="0,0,0,4">
                                                                <TextBlock Classes="cfp-caption"
                                                                           Text="{Binding Path}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding Path}" />
                                                                <TextBox Grid.Column="1"
                                                                         Classes="cfp-input"
                                                                         Text="{Binding Value, Mode=TwoWay}"
                                                                         AutomationProperties.Name="{Binding Path}" />
                                                                <TextBlock Grid.Column="2"
                                                                           Classes="cfp-meta"
                                                                           Text="{Binding Kind}"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                            <TextBlock Margin="24"
                                                       Classes="cfp-meta"
                                                       Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Loc[NoSaveSlots]}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding Slots.Count, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}" />
                                        </Grid>
                                    </u:LoadingContainer>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right">
                                        <Button Classes="cfp-secondary" Command="{Binding ResetCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="RotateCcw" Size="16" />
                                                <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Loc[ResetConfig]}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="cfp-primary"
                                                Command="{Binding SaveCommand}"
                                                IsEnabled="{Binding CanSave}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="Save" Size="16" />
                                                <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Loc[Save]}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="16"
                                        Classes="cfp-tab-panel cfp-subpage"
                                        IsVisible="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Logs}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0" Classes="cfp-page-title" Text="{Binding Loc[Logs]}" />
                                    <Button Grid.Column="1"
                                            Classes="cfp-secondary"
                                            Command="{Binding RefreshLogsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <LucideIcon Kind="RefreshCw" Size="16" />
                                            <TextBlock Text="{Binding Loc[RefreshLogs]}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="240,16,*" MinHeight="360">
                                    <Border Grid.Column="0" Classes="cfp-list-frame">
                                        <Grid>
                                            <ListBox Classes="cfp-list"
                                                     ItemsSource="{Binding InstanceLogs}"
                                                     SelectedItem="{Binding SelectedLogFile, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:CompileBindings="False">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Classes="cfp-row-title" Text="{Binding Name}" />
                                                            <TextBlock Classes="cfp-caption" Text="{Binding SizeBytes}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Margin="20"
                                                       Classes="cfp-meta"
                                                       Text="{Binding Loc[NoLogs]}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding InstanceLogs.Count, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Grid.Row="0"
                                                   Classes="cfp-caption"
                                                   Text="{Binding SelectedLogFile.Path}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding SelectedLogFile.Path}" />
                                        <TextBox Grid.Row="1"
                                                 Classes="cfp-input"
                                                 Text="{Binding LogContent}"
                                                 IsReadOnly="True"
                                                  AcceptsReturn="True"
                                                  TextWrapping="NoWrap"
                                                  FontFamily="Consolas"
                                                  AutomationProperties.Name="{Binding Loc[Logs]}"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <StackPanel Name="GameConfigPanel"
                                        Spacing="16"
                                        Classes="cfp-tab-panel cfp-subpage"
                                        IsVisible="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Config}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="cfp-page-title" Text="{Binding Loc[Config]}" />
                                    <TextBlock Classes="cfp-meta"
                                               Text="{Binding Loc[ConfigHint]}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Classes="cfp-error" IsVisible="{Binding IsGameRunning}">
                                    <TextBlock Text="{Binding Loc[ConfigLocked]}" TextWrapping="Wrap" />
                                </Border>
                                <Border Classes="cfp-card"
                                        IsVisible="{Binding GameConfig, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                                    <StackPanel Spacing="16"
                                                IsEnabled="{Binding IsGameRunning, Converter={x:Static converters:BoolConverters.Not}}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Classes="cfp-section-title" Text="{Binding Loc[Accessibility]}" />
                                            <Grid ColumnDefinitions="220,*,64"
                                                  ColumnSpacing="12"
                                                  IsVisible="{Binding SupportsAccessibility}">
                                                <TextBlock Text="{Binding Loc[ReducedCameraShake]}"
                                                           VerticalAlignment="Center" />
                                                <Slider Grid.Column="1"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding GameConfig.ReducedCameraShake, Mode=TwoWay}"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding Loc[ReducedCameraShake]}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding GameConfig.ReducedCameraShake, StringFormat={}{0:0.00}}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid ColumnDefinitions="220,*,64" ColumnSpacing="12">
                                                <TextBlock Text="{Binding Loc[ReducedControllerRumble]}"
                                                           VerticalAlignment="Center" />
                                                <Slider Grid.Column="1"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding GameConfig.ReducedControllerRumble, Mode=TwoWay}"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding Loc[ReducedControllerRumble]}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding GameConfig.ReducedControllerRumble, StringFormat={}{0:0.00}}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="cfp-section-title" Text="{Binding Loc[AdvancedConfig]}" />
                                                    <TextBlock Classes="cfp-meta"
                                                               Text="{Binding Loc[AdvancedConfigHint]}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Classes="cfp-secondary"
                                                        Command="{Binding GameConfig.AddEntryCommand}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <LucideIcon Kind="Plus" Size="16" />
                                                        <TextBlock Text="{Binding Loc[AddEntry]}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid ColumnDefinitions="150,190,*,Auto" ColumnSpacing="8">
                                                <TextBlock Classes="cfp-caption" Text="{Binding Loc[ConfigSection]}" />
                                                <TextBlock Grid.Column="1" Classes="cfp-caption" Text="{Binding Loc[ConfigKey]}" />
                                                <TextBlock Grid.Column="2" Classes="cfp-caption" Text="{Binding Loc[ConfigValue]}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding GameConfig.Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ConfigEntryViewModel">
                                                        <Grid ColumnDefinitions="150,190,*,Auto"
                                                              ColumnSpacing="8"
                                                              Margin="0,0,0,6">
                                                            <TextBox Classes="cfp-input"
                                                                     Text="{Binding Section, Mode=TwoWay}"
                                                                     AutomationProperties.Name="{Binding #Root.DataContext.Loc[ConfigSection]}" />
                                                            <TextBox Grid.Column="1"
                                                                     Classes="cfp-input"
                                                                     Text="{Binding Key, Mode=TwoWay}"
                                                                     AutomationProperties.Name="{Binding #Root.DataContext.Loc[ConfigKey]}" />
                                                            <TextBox Grid.Column="2"
                                                                     Classes="cfp-input"
                                                                     Text="{Binding Value, Mode=TwoWay}"
                                                                     AutomationProperties.Name="{Binding #Root.DataContext.Loc[ConfigValue]}" />
                                                            <Button Grid.Column="3"
                                                                    Classes="cfp-icon"
                                                                    Command="{Binding #Root.DataContext.GameConfig.RemoveEntryCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{Binding #Root.DataContext.Loc[RemoveEntry]}"
                                                                    AutomationProperties.Name="{Binding #Root.DataContext.Loc[RemoveEntry]}"
                                                                    Content="{LucideIconContent Trash2, 16}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Name="ConfigSaveButton"
                                                    Classes="cfp-accent"
                                                    Command="{Binding GameConfig.SaveCommand}"
                                                    IsEnabled="{Binding GameConfig.IsDirty}"
                                                    Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <LucideIcon Kind="Save" Size="16" />
                                                    <TextBlock Text="{Binding Loc[SaveConfig]}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Name="ConfigResetButton"
                                                    Classes="cfp-secondary"
                                                    Command="{Binding GameConfig.ResetCommand}"
                                                    Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <LucideIcon Kind="RotateCcw" Size="16" />
                                                    <TextBlock Text="{Binding Loc[ResetConfig]}" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Grid Grid.Column="1"
                          Classes="cfp-mods-workspace cfp-tab-panel cfp-subpage"
                          Margin="24"
                          MaxWidth="1920"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto,Auto,*,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12"
                          IsVisible="{Binding CurrentManageTab, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter=Mods}">
                        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="cfp-page-title" Text="{Binding Loc[InstalledMods]}" />
                                <TextBlock Classes="cfp-meta" Text="{Binding ModManagement.SelectedModCount}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Classes="cfp-mod-quick-actions" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Classes="cfp-icon cfp-quick-action cfp-graph-toggle"
                                        Classes.active="{Binding ModManagement.IsInstalledModListVisible}"
                                        Command="{Binding ModManagement.ShowInstalledModListCommand}"
                                        ToolTip.Tip="{Binding Loc[DependencyList]}"
                                        AutomationProperties.Name="{Binding Loc[DependencyList]}"
                                        Content="{LucideIconContent List, 16}" />
                                <Button Classes="cfp-icon cfp-quick-action cfp-graph-toggle"
                                        Classes.active="{Binding ModManagement.IsInstalledModGraphVisible}"
                                        Command="{Binding ModManagement.ShowInstalledModGraphCommand}"
                                        ToolTip.Tip="{Binding Loc[DependencyGraph]}"
                                        AutomationProperties.Name="{Binding Loc[DependencyGraph]}"
                                        Content="{LucideIconContent Network, 16}" />
                                <Button Classes="cfp-icon cfp-quick-action" Click="OpenInstalledModRoot" ToolTip.Tip="{Binding Loc[OpenFolder]}" AutomationProperties.Name="{Binding Loc[OpenFolder]}" Content="{LucideIconContent FolderOpen, 16}" />
                                <Button Classes="cfp-icon cfp-quick-action" Click="ImportLocalModPackage" ToolTip.Tip="{Binding Loc[ImportLocalMod]}" AutomationProperties.Name="{Binding Loc[ImportLocalMod]}" Content="{LucideIconContent PackagePlus, 16}" />
                                <Button Classes="cfp-icon cfp-quick-action" Command="{Binding OpenModMarketForSelectedInstanceCommand}" ToolTip.Tip="{Binding Loc[ModMarket]}" AutomationProperties.Name="{Binding Loc[ModMarket]}" Content="{LucideIconContent Store, 16}" />
                                <Button Classes="cfp-icon cfp-quick-action" Command="{Binding ModManagement.SelectAllInstalledModsCommand}" ToolTip.Tip="{Binding Loc[SelectAll]}" AutomationProperties.Name="{Binding Loc[SelectAll]}" Content="{LucideIconContent ListChecks, 16}" />
                                <Button Classes="cfp-icon cfp-quick-action" Command="{Binding ModManagement.CheckForUpdatesCommand}" ToolTip.Tip="{Binding Loc[CheckAllForUpdates]}" AutomationProperties.Name="{Binding Loc[CheckAllForUpdates]}">
                                    <Grid Width="16" Height="16">
                                        <LucideIcon Kind="RefreshCcw" Size="16" />
                                        <Border Classes="cfp-update-badge" Width="8" Height="8" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource CfAccentBrush}" IsVisible="{Binding ModManagement.HasUpdatesAvailable}" />
                                    </Grid>
                                </Button>
                            </WrapPanel>
                        </Grid>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                              IsVisible="{Binding ModManagement.IsInstalledModListVisible}">
                            <TextBox Classes="cfp-input" Text="{Binding ModManagement.ModSearchText, Mode=TwoWay}" PlaceholderText="{Binding Loc[FilterMods]}" AutomationProperties.Name="{Binding Loc[FilterMods]}" />
                            <ComboBox Grid.Column="1" Width="160" Classes="cfp-input" ItemsSource="{Binding ModManagement.ModStatusOptions}" SelectedItem="{Binding ModManagement.SelectedModStatusOption, Mode=TwoWay}" AutomationProperties.Name="{Binding Loc[FilterAll]}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6">
                            <Border Classes="cfp-error" IsVisible="{Binding HasModDependencyProblems}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{Binding Loc[DependencyProblem]}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="cfp-secondary" Click="ConfirmRepairDependencies" Content="{Binding Loc[RepairDependencies]}" />
                                </Grid>
                            </Border>
                            <Border Classes="cfp-card" Padding="10,7" IsVisible="{Binding ModManagement.HasUnusedDependencySuggestions}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <LucideIcon Kind="Info" Size="15" />
                                    <TextBlock Classes="cfp-meta" Text="{Binding ModManagement.UnusedDependencySummary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Grid.Row="3"
                                Classes="cfp-list-frame cfp-dependency-graph-frame"
                                IsVisible="{Binding ModManagement.IsInstalledModGraphVisible}">
                            <controls:DependencyGraphView Margin="8"
                                                          MinHeight="340"
                                                          Localization="{Binding #Root.DataContext.Loc}"
                                                          DataContext="{Binding DependencyGraph.Graph}" />
                        </Border>
                        <Border Grid.Row="3" Classes="cfp-list-frame"
                                IsVisible="{Binding ModManagement.IsInstalledModListVisible}">
                            <ListBox x:Name="InstalledModsList" Classes="cfp-list cfp-installed-mod-list" ItemsSource="{Binding ModManagement.VisibleInstalledMods}" SelectedItem="{Binding ModManagement.SelectedInstalledMod, Mode=TwoWay}" KeyDown="OnInstalledModsKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InstalledModItemViewModel">
                                        <Grid Classes="cfp-installed-mod-row" Classes.selected="{Binding IsSelected}" Classes.disabled="{Binding IsEnabled, Converter={x:Static converters:BoolConverters.Not}}" Classes.conflict="{Binding HasConflicts}" Background="Transparent" ColumnDefinitions="3,*,Auto" ColumnSpacing="8">
                                            <Border Classes="cfp-installed-mod-accent" Width="3" CornerRadius="2" Background="{DynamicResource CfAccentBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Classes="cfp-installed-mod-name" Text="{Binding PrimaryName}" Classes.disabled="{Binding IsEnabled, Converter={x:Static converters:BoolConverters.Not}}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Classes="cfp-meta" Text="{Binding SecondaryName}" IsVisible="{Binding HasSecondaryName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="cfp-meta" Text="{Binding Version}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="cfp-meta" Text="{Binding OwnershipDisplayName}" />
                                                    <TextBlock Classes="cfp-meta" Text="{Binding HealthDisplayName}" />
                                                    <TextBlock Classes="cfp-meta" Text="{Binding #Root.DataContext.Loc[Pinned]}" IsVisible="{Binding IsPinned}" />
                                                    <TextBlock Classes="cfp-caption cfp-mod-conflict" Text="{Binding ConflictWithText}" IsVisible="{Binding HasConflicts}" Foreground="{DynamicResource CfErrorBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Classes="cfp-installed-mod-actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Classes="cfp-icon cfp-mod-action" Click="OpenInstalledModInfo" IsVisible="{Binding HasCatalogManifest}" ToolTip.Tip="{Binding #Root.DataContext.Loc[Information]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[Information]}" Content="{LucideIconContent Info, 15}" />
                                                <Button Classes="cfp-icon cfp-mod-action" Click="OpenInstalledModFolder" ToolTip.Tip="{Binding #Root.DataContext.Loc[OpenFolder]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[OpenFolder]}" Content="{LucideIconContent FolderOpen, 15}" />
                                                <Button Classes="cfp-icon cfp-mod-action" Click="ShowInstalledModHealth" IsVisible="{Binding HasHealthIssue}" ToolTip.Tip="{Binding HealthDisplayName}" AutomationProperties.Name="{Binding HealthDisplayName}" Content="{LucideIconContent ShieldAlert, 15}" />
                                                <Button Classes="cfp-icon cfp-mod-action" Click="TakeOverHoveredInstalledMod" IsVisible="{Binding CanTakeOver}" ToolTip.Tip="{Binding #Root.DataContext.Loc[TakeOverMod]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[TakeOverMod]}" Content="{LucideIconContent Import, 15}" />
                                                <Button Classes="cfp-icon cfp-mod-action" Click="RepairHoveredInstalledMod" IsVisible="{Binding CanRepair}" ToolTip.Tip="{Binding #Root.DataContext.Loc[RepairMod]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[RepairMod]}" Content="{LucideIconContent Wrench, 15}" />
                                                <Button Classes="cfp-icon cfp-mod-action" Click="AcceptHoveredLocalModFiles" IsVisible="{Binding CanAcceptCurrent}" ToolTip.Tip="{Binding #Root.DataContext.Loc[AcceptCurrentFiles]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[AcceptCurrentFiles]}" Content="{LucideIconContent FileCheck, 15}" />
                                                <Button Classes="cfp-icon cfp-mod-action" Click="ReimportHoveredLocalMod" IsVisible="{Binding CanReimport}" ToolTip.Tip="{Binding #Root.DataContext.Loc[ReimportLocalMod]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[ReimportLocalMod]}" Content="{LucideIconContent PackageOpen, 15}" />
                                                <Button Classes="cfp-icon cfp-mod-action" Click="ToggleHoveredModPinned" IsVisible="{Binding CanPin}" ToolTip.Tip="{Binding #Root.DataContext.Loc[PinMod]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[PinMod]}" Content="{LucideIconContent Pin, 15}" />
                                                <Button Classes="cfp-icon cfp-mod-action" Click="ToggleHoveredInstalledMod" IsVisible="{Binding CanToggle}" ToolTip.Tip="{Binding #Root.DataContext.Loc[EnableDisable]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[EnableDisable]}" Content="{LucideIconContent Power, 15}" />
                                                <Button Classes="cfp-icon cfp-mod-action danger" Click="ConfirmHoveredModUninstall" IsVisible="{Binding CanUninstall}" ToolTip.Tip="{Binding #Root.DataContext.Loc[Uninstall]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[Uninstall]}" Content="{LucideIconContent Trash2, 15}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Row="3"
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                Classes="cfp-mod-detail-panel cfp-card cfp-accent-frame"
                                Width="320"
                                IsVisible="{Binding ModManagement.SelectedInstalledMod, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[ModDetails]}" />
                                        <TextBlock Classes="cfp-row-title" Text="{Binding ModManagement.SelectedInstalledMod.PrimaryName}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="cfp-meta" Text="{Binding Loc[CurrentVersion]}" />
                                            <TextBlock Classes="cfp-meta" Text="{Binding ModManagement.SelectedInstalledMod.Version}" />
                                        </StackPanel>
                                        <Button Classes="cfp-link" HorizontalAlignment="Left" MinHeight="36"
                                                Command="{Binding MatchSelectedModToCatalogCommand}"
                                                IsVisible="{Binding ModManagement.SelectedInstalledMod.CanMatchToCatalog}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <LucideIcon Kind="Search" Size="14" />
                                                <TextBlock Text="{Binding Loc[MatchToCatalog]}" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ModManagement.SelectedInstalledMod.HasLatestVersion}">
                                            <TextBlock Classes="cfp-meta" Text="{Binding Loc[LatestVersion]}" />
                                            <TextBlock Classes="cfp-meta" Text="{Binding ModManagement.SelectedInstalledMod.LatestVersionText}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="2" IsVisible="{Binding ModManagement.SelectedInstalledMod.HasConflicts}">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[FileConflicts]}" />
                                        <TextBlock Classes="cfp-meta cfp-mod-conflict" Text="{Binding ModManagement.SelectedInstalledMod.ConflictWithText}" Foreground="{DynamicResource CfErrorBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="2" IsVisible="{Binding ModManagement.SelectedInstalledMod.HasCatalogManifest}">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[Dependencies]}" />
                                        <TextBlock Classes="cfp-meta" Text="{Binding ModManagement.SelectedInstalledMod.DependenciesText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="2" IsVisible="{Binding ModManagement.SelectedInstalledMod.HasCatalogManifest}">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[Authors]}" />
                                        <TextBlock Classes="cfp-meta" Text="{Binding ModManagement.SelectedInstalledMod.AuthorsText}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ModManagement.SelectedInstalledMod.HasRepositoryUrl}">
                                            <TextBlock Classes="cfp-section-title" Text="{Binding Loc[Repository]}" />
                                            <Button Classes="cfp-link" Tag="{Binding ModManagement.SelectedInstalledMod.RepositoryUrl}" Click="OpenExternalUrl" AutomationProperties.Name="{Binding Loc[Repository]}">
                                                <TextBlock Text="{Binding ModManagement.SelectedInstalledMod.RepositoryUrl}" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="2" IsVisible="{Binding ModManagement.SelectedInstalledMod.HasModifiedFilesText}">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[ModifiedFiles]}" />
                                        <TextBlock Classes="cfp-meta" Text="{Binding ModManagement.SelectedInstalledMod.ModifiedFilesText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="2" IsVisible="{Binding ModManagement.SelectedInstalledMod.HasInstallDate}">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[InstallHistory]}" />
                                        <TextBlock Classes="cfp-meta" Text="{Binding ModManagement.SelectedInstalledMod.InstallDateText}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="4" Classes="cfp-mod-bulk-bar" IsVisible="{Binding ModManagement.IsInstalledModBulkBarVisible}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <TextBlock Classes="cfp-row-title" Text="{Binding ModManagement.SelectedModCount}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="cfp-meta" Text="{Binding Loc[SelectedMods]}" VerticalAlignment="Center" />
                                <WrapPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Classes="cfp-icon" Command="{Binding ModManagement.EnableSelectedModsCommand}" ToolTip.Tip="{Binding Loc[Enable]}" AutomationProperties.Name="{Binding Loc[Enable]}" Content="{LucideIconContent CirclePlay, 15}" />
                                    <Button Classes="cfp-icon" Command="{Binding ModManagement.DisableSelectedModsCommand}" ToolTip.Tip="{Binding Loc[Disable]}" AutomationProperties.Name="{Binding Loc[Disable]}" Content="{LucideIconContent CirclePause, 15}" />
                                    <Button Classes="cfp-icon" Command="{Binding ModManagement.UpdateSelectedModsCommand}" ToolTip.Tip="{Binding Loc[Update]}" AutomationProperties.Name="{Binding Loc[Update]}" Content="{LucideIconContent RefreshCw, 15}" />
                                    <Button Classes="cfp-icon danger" Click="ConfirmBulkUninstallMods" ToolTip.Tip="{Binding Loc[Uninstall]}" AutomationProperties.Name="{Binding Loc[Uninstall]}" Content="{LucideIconContent Trash2, 15}" />
                                    <Button Classes="cfp-icon" Command="{Binding ModManagement.ClearInstalledModSelectionCommand}" ToolTip.Tip="{Binding Loc[ClearSelection]}" AutomationProperties.Name="{Binding Loc[ClearSelection]}" Content="{LucideIconContent X, 15}" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Speedrun -->
            <Grid Classes="cfp-page" IsVisible="{Binding IsSpeedrunPage}">
                <Grid RowDefinitions="*" Margin="0,16">
                    <Border Classes="cfp-speedrun-tab-switch"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4"
                            ZIndex="10">
                        <Grid Width="196" ColumnDefinitions="*,*">
                            <Border x:Name="SpeedrunTabIndicator"
                                    Grid.Column="0"
                                    Classes="cfp-speedrun-tab-indicator">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                            </Border>
                            <Button Classes="cfp-speedrun-tab-segment"
                                    Classes.active="{Binding IsSpeedrunEnvironmentTab}"
                                    Command="{Binding SelectSpeedrunTabCommand}"
                                    CommandParameter="Environment"
                                    AutomationProperties.Name="{Binding Loc[SpeedrunEnvironmentTab]}">
                                <TextBlock Text="{Binding Loc[SpeedrunEnvironmentTab]}" />
                            </Button>
                            <Button Grid.Column="1"
                                    Classes="cfp-speedrun-tab-segment"
                                    Classes.active="{Binding IsSpeedrunActivityTab}"
                                    Command="{Binding SelectSpeedrunTabCommand}"
                                    CommandParameter="Activity"
                                    AutomationProperties.Name="{Binding Loc[SpeedrunActivityTab]}">
                                <TextBlock Text="{Binding Loc[SpeedrunActivityTab]}" />
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Classes="cfp-rail cfp-speedrun-rail" Width="216" Padding="12,16" Margin="0,0,12,0" IsVisible="{Binding IsSpeedrunEnvironmentTab}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                            <TextBlock Classes="cfp-section-title" Text="{Binding Loc[SpeedrunTitle]}" />
                            <TextBlock Grid.Row="1" Classes="cfp-meta" Text="{Binding Loc[SpeedrunInstancesHint]}" TextWrapping="Wrap" />
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding Instances.SpeedrunInstances}"
                                     SelectedItem="{Binding SelectedSpeedrunInstance, Mode=TwoWay}"
                                     Classes="cfp-list"
                                     AutomationProperties.Name="{Binding Loc[SpeedrunInstances]}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Classes="cfp-list-row">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="cfp-row-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="cfp-meta" Text="{Binding DisplayVersion}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="3" Classes="cfp-speedrun-create">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="cfp-row-title" Text="{Binding Loc[SpeedrunCreate]}" />
                                    <ComboBox ItemsSource="{Binding SpeedrunTemplates}"
                                              SelectedItem="{Binding SelectedSpeedrunTemplate}"
                                              DisplayMemberBinding="{Binding Name}"
                                              PlaceholderText="{Binding Loc[SelectSpeedrunTemplate]}" />
                                    <ComboBox ItemsSource="{Binding SpeedrunSourceInstances}"
                                              SelectedItem="{Binding SelectedSpeedrunSourceInstance}"
                                              DisplayMemberBinding="{Binding Name}"
                                              PlaceholderText="{Binding Loc[SpeedrunSelectVanillaSource]}" />
                                    <Button Classes="cfp-primary"
                                            Click="ShowCreateSpeedrunEnvironmentDialog"
                                            HorizontalAlignment="Stretch"
                                            Content="{Binding Loc[SpeedrunCreate]}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Column="1"
                                      x:Name="SpeedrunWorkspace"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PointerPressed="OnSpeedrunWorkspacePointerPressed"
                                      PointerReleased="OnSpeedrunWorkspacePointerReleased">
                            <Grid MinHeight="{Binding #SpeedrunWorkspace.Bounds.Height}">
                        <Grid Classes="cfp-workspace cfp-subpage" RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="0,0,0,44" IsVisible="{Binding IsSpeedrunEnvironmentTab}">
                            <Border Classes="cfp-card cfp-speedrun-summary"
                                    Padding="14"
                                    IsVisible="{Binding HasSelectedSpeedrunInstance}">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="cfp-page-title"
                                                   Text="{Binding SelectedSpeedrunInstance.Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="cfp-meta"
                                                   Text="{Binding SelectedSpeedrunInstance.DisplayVersion}" />
                                        <TextBlock Classes="cfp-status"
                                                   Text="{Binding SelectedSpeedrunTechnicalStatus}" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               Orientation="Horizontal"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top">
                                        <Button Classes="cfp-primary" Command="{Binding LaunchGameCommand}" Content="{Binding Loc[SpeedrunVerifyAndLaunch]}" />
                                        <Button Classes="cfp-icon"
                                                Command="{Binding ReinstallSpeedrunEnvironmentCommand}"
                                                IsEnabled="{Binding IsSelectedSpeedrunCurrent}"
                                                ToolTip.Tip="{Binding Loc[SpeedrunReinstall]}"
                                                AutomationProperties.Name="{Binding Loc[SpeedrunReinstall]}"
                                                Content="{LucideIconContent RefreshCw, 16}" />
                                        <Button Classes="cfp-icon" Click="OpenSelectedInstanceFolder" ToolTip.Tip="{Binding Loc[OpenFolder]}" AutomationProperties.Name="{Binding Loc[OpenFolder]}" Content="{LucideIconContent FolderOpen, 16}" />
                                        <Button Classes="cfp-icon danger" Click="ConfirmDeleteSelectedInstance" ToolTip.Tip="{Binding Loc[DeleteInstance]}" AutomationProperties.Name="{Binding Loc[DeleteInstance]}" Content="{LucideIconContent Trash2, 16}" />
                                    </WrapPanel>
                                    <Border Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Classes="cfp-speedrun-status">
                                        <TextBlock Classes="cfp-meta"
                                                   Text="{Binding SpeedrunStatus}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <Grid Grid.Row="2"
                                          Grid.ColumnSpan="2"
                                          ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="8"
                                          IsVisible="{Binding HasSpeedrunReport}">
                                        <LucideIcon Kind="FileText" Size="14" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="cfp-meta"
                                                   Text="{Binding SpeedrunReportPath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding SpeedrunReportPath}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Classes="cfp-icon"
                                                Click="OpenSpeedrunReport"
                                                ToolTip.Tip="{Binding Loc[SpeedrunOpenReport]}"
                                                AutomationProperties.Name="{Binding Loc[SpeedrunOpenReport]}"
                                                Content="{LucideIconContent ExternalLink, 15}" />
                                        <Button Grid.Column="3"
                                                Classes="cfp-icon"
                                                Click="CopySpeedrunReportPath"
                                                ToolTip.Tip="{Binding Loc[SpeedrunCopyReportPath]}"
                                                AutomationProperties.Name="{Binding Loc[SpeedrunCopyReportPath]}"
                                                Content="{LucideIconContent Copy, 15}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Classes="cfp-card"
                                    Padding="16"
                                    IsVisible="{Binding HasSelectedSpeedrunInstance, Converter={x:Static converters:BoolConverters.Not}}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="cfp-section-title" Text="{Binding Loc[SpeedrunTitle]}" />
                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[SpeedrunInstancesHint]}" TextWrapping="Wrap" />
                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[SpeedrunHint]}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2"
                                    Classes="cfp-card cfp-speedrun-config"
                                    Padding="14"
                                    IsVisible="{Binding HasSelectedSpeedrunInstance}"
                                    IsEnabled="{Binding IsRuntimePatchesConfigurationEditable}">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="cfp-section-title" Text="{Binding Loc[SpeedrunConfiguration]}" />
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                        <Border Classes="cfp-speedrun-option">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Loc[SpeedrunScreenShakeModifier]}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[SpeedrunFeatureUnavailable]}" IsVisible="{Binding IsScreenShakeModifierAvailable, Converter={x:Static converters:BoolConverters.Not}}" />
                                                    <ToggleSwitch IsChecked="{Binding RuntimePatchesScreenShakeModifier}" IsVisible="{Binding IsScreenShakeModifierAvailable}" AutomationProperties.Name="{Binding Loc[SpeedrunScreenShakeModifier]}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="1" Classes="cfp-speedrun-option" IsVisible="{Binding IsMultiSaveStatesAvailable}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Loc[SpeedrunSaveStates]}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[SpeedrunSaveStatesSwitchHint]}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                    <RadioButton GroupName="speedrun-save-states-mode"
                                                                 Content="{Binding Loc[MotionOff]}"
                                                                 IsChecked="{Binding IsNoSaveStatesModeSelected, Mode=TwoWay}"
                                                                 AutomationProperties.Name="{Binding Loc[MotionOff]}" />
                                                    <RadioButton GroupName="speedrun-save-states-mode"
                                                                 Content="{Binding Loc[SpeedrunMiniSaveStates]}"
                                                                 IsChecked="{Binding IsMiniSaveStatesModeSelected, Mode=TwoWay}"
                                                                 AutomationProperties.Name="{Binding Loc[SpeedrunMiniSaveStates]}" />
                                                    <RadioButton GroupName="speedrun-save-states-mode"
                                                                 Content="{Binding Loc[SpeedrunMultiSaveStates]}"
                                                                 IsChecked="{Binding IsMultiSaveStatesModeSelected, Mode=TwoWay}"
                                                                 AutomationProperties.Name="{Binding Loc[SpeedrunMultiSaveStates]}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="1" Classes="cfp-speedrun-option" IsVisible="{Binding IsMultiSaveStatesAvailable, Converter={x:Static converters:BoolConverters.Not}}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Loc[SpeedrunMiniSaveStates]}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[SpeedrunFeatureUnavailable]}" IsVisible="{Binding IsMiniSaveStatesAvailable, Converter={x:Static converters:BoolConverters.Not}}" />
                                                    <ToggleSwitch IsChecked="{Binding RuntimePatchesMiniSaveStates}" IsVisible="{Binding IsMiniSaveStatesAvailable}" IsEnabled="{Binding IsMiniSaveStatesToggleEnabled}" AutomationProperties.Name="{Binding Loc[SpeedrunMiniSaveStates]}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="2" Classes="cfp-speedrun-option">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Loc[SpeedrunFasterIntroSkip]}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[SpeedrunFeatureUnavailable]}" IsVisible="{Binding IsFasterIntroSkipAvailable, Converter={x:Static converters:BoolConverters.Not}}" />
                                                    <ToggleSwitch IsChecked="{Binding RuntimePatchesFasterIntroSkip}" IsVisible="{Binding IsFasterIntroSkipAvailable}" AutomationProperties.Name="{Binding Loc[SpeedrunFasterIntroSkip]}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="3" Classes="cfp-speedrun-option">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Loc[SpeedrunTextMasher]}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[SpeedrunFeatureUnavailable]}" IsVisible="{Binding IsTextMasherAvailable, Converter={x:Static converters:BoolConverters.Not}}" />
                                                    <ToggleSwitch IsChecked="{Binding RuntimePatchesTextMasher}" IsVisible="{Binding IsTextMasherAvailable}" AutomationProperties.Name="{Binding Loc[SpeedrunTextMasher]}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[SpeedrunFeatureWarnings]}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Classes="cfp-card"
                                    Padding="14"
                                    IsVisible="{Binding IsSelectedSpeedrunLegacy}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="cfp-section-title" Text="{Binding Loc[SpeedrunTemplateExpired]}" />
                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[SpeedrunNeedsVerification]}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Classes="cfp-workspace cfp-speedrun-activity cfp-subpage" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10" Margin="0,0,0,44" IsVisible="{Binding IsSpeedrunActivityTab}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="cfp-section-title" Text="{Binding Loc[SpeedrunActivityTitle]}" />
                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[SpeedrunActivityHint]}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="cfp-icon"
                                        Command="{Binding RefreshSpeedrunActivityCommand}"
                                        ToolTip.Tip="{Binding Loc[SpeedrunRefresh]}"
                                        AutomationProperties.Name="{Binding Loc[SpeedrunRefresh]}"
                                        Content="{LucideIconContent RefreshCw, 16}" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                <Button Classes="cfp-filter-chip" Classes.active="{Binding IsSpeedrunActivityFilterAll}" Command="{Binding SelectSpeedrunActivityFilterCommand}" CommandParameter="All" Content="{Binding Loc[SpeedrunActivityAll]}" />
                                <Button Classes="cfp-filter-chip" Classes.active="{Binding IsSpeedrunActivityFilterHollowKnight}" Command="{Binding SelectSpeedrunActivityFilterCommand}" CommandParameter="HollowKnight" Content="{Binding Loc[SpeedrunGameHollowKnight]}" />
                                <Button Classes="cfp-filter-chip" Classes.active="{Binding IsSpeedrunActivityFilterSilksong}" Command="{Binding SelectSpeedrunActivityFilterCommand}" CommandParameter="Silksong" Content="{Binding Loc[SpeedrunGameSilksong]}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding VisibleSpeedrunActivities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="cfp-speedrun-activity-row" Classes.wr="{Binding IsWorldRecord}" Margin="0,0,0,6" Padding="12,9">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                    <TextBlock Classes="cfp-status" Text="{Binding KindText}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="cfp-row-title" Text="{Binding Run.PlayerName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="cfp-meta" Text="{Binding BoardName}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                                        <TextBlock Classes="cfp-tabular" Text="{Binding Run.DisplayTime}" HorizontalAlignment="Right" />
                                                        <TextBlock Classes="cfp-meta cfp-tabular" Text="{Binding DisplayVerifiedAt}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Classes="cfp-icon" Tag="{Binding Run.RunUrl}" Click="OpenSpeedrunRun" IsVisible="{Binding Run.RunUrl, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="{Binding #Root.DataContext.Loc[SpeedrunOpenRun]}" AutomationProperties.Name="{Binding #Root.DataContext.Loc[SpeedrunOpenRun]}" Content="{LucideIconContent ExternalLink, 14}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Grid.Row="2" Classes="cfp-meta" Text="{Binding Loc[SpeedrunActivityEmpty]}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowSpeedrunActivityEmptyState}" />
                            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <ProgressBar Width="72" Height="3" IsIndeterminate="True" IsVisible="{Binding IsSpeedrunActivityLoading}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="cfp-meta" Text="{Binding SpeedrunActivityStatus}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="cfp-meta" Text="{Binding SpeedrunActivityUpdatedAt}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Grid.Row="4" Classes="cfp-error" IsVisible="{Binding HasSpeedrunActivityError}">
                                <TextBlock Classes="cfp-meta" Text="{Binding SpeedrunActivityError}" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Downloads -->
            <Grid Classes="cfp-page" IsVisible="{Binding IsDownloadsPage}">
                <Grid ColumnDefinitions="176,*" x:CompileBindings="False">
                    <Border Grid.Column="0" Classes="cfp-rail cfp-download-rail" Padding="8,16">
                        <StackPanel Classes="cfp-manage-nav" Spacing="4" IsEnabled="{Binding CanNavigate}">
                            <Button Classes="cfp-local-nav"
                                    Classes.active="{Binding IsGameVersionsDownloadSection}"
                                    Command="{Binding SelectDownloadSectionCommand}"
                                    CommandParameter="GameVersions"
                                    AutomationProperties.Name="{Binding Loc[GameVersions]}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <LucideIcon Kind="HardDriveDownload" Size="16" />
                                    <TextBlock Grid.Column="1" Text="{Binding Loc[GameVersions]}" />
                                </Grid>
                            </Button>
                            <Button Classes="cfp-local-nav"
                                    Classes.active="{Binding IsModMarketDownloadSection}"
                                    Command="{Binding SelectDownloadSectionCommand}"
                                    CommandParameter="ModMarket"
                                    AutomationProperties.Name="{Binding Loc[ModMarket]}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <LucideIcon Kind="Store" Size="16" />
                                    <TextBlock Grid.Column="1" Text="{Binding Loc[ModMarket]}" />
                                </Grid>
                            </Button>
                            <Button Classes="cfp-local-nav"
                                    Classes.active="{Binding IsDownloadQueueSection}"
                                    Command="{Binding SelectDownloadSectionCommand}"
                                    CommandParameter="DownloadQueue"
                                    AutomationProperties.Name="{Binding Loc[DownloadQueue]}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <LucideIcon Kind="ListTodo" Size="16" />
                                    <TextBlock Grid.Column="1" Text="{Binding Loc[DownloadQueue]}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1"
                                  Classes="cfp-subpage"
                                  IsVisible="{Binding IsGameVersionsDownloadSection}"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="cfp-workspace"
                                    Margin="24"
                                    Spacing="16"
                                    MaxWidth="1920"
                                    HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="cfp-page-title" Text="{Binding Loc[GameVersions]}" />
                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[DownloadsHint]}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border x:Name="SteamChunkCacheCard"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding Loc[SteamChunkCacheHint]}">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                                        <LucideIcon Kind="Database" Size="17" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Classes="cfp-row-title" Text="{Binding Loc[SteamChunkCacheTitle]}" />
                                            <TextBlock Classes="cfp-meta" Text="{Binding DownloadCenter.SteamChunkCacheUsageText}" />
                                        </StackPanel>
                                        <Button x:Name="SteamChunkCacheClearButton"
                                                Grid.Column="2"
                                                Classes="cfp-icon"
                                                Click="ConfirmClearSteamChunkCache"
                                                IsEnabled="{Binding DownloadCenter.CanClearSteamChunkCache}"
                                                ToolTip.Tip="{Binding Loc[ClearSteamChunkCache]}"
                                                AutomationProperties.Name="{Binding Loc[ClearSteamChunkCache]}"
                                                Content="{LucideIconContent Trash2, 16}" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Classes="cfp-download-account">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <LucideIcon Kind="UserRound" Size="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="cfp-row-title" Text="{Binding Loc[SteamAccount]}" />
                                        <TextBlock Classes="cfp-meta" Text="{Binding SteamStatus}" TextWrapping="Wrap" />
                                        <TextBlock Classes="cfp-meta" Text="{Binding SteamNetworkStatus}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                        <Button Classes="cfp-accent" Command="{Binding SignInWithQrCommand}" IsVisible="{Binding IsSteamLoggedIn, Converter={x:Static converters:BoolConverters.Not}}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="LogIn" Size="16" />
                                                <TextBlock Text="{Binding Loc[SignInQr]}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="cfp-link" Command="{Binding TogglePasswordLoginCommand}" MinHeight="36" IsVisible="{Binding IsSteamLoggedIn, Converter={x:Static converters:BoolConverters.Not}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <LucideIcon Kind="KeyRound" Size="14" />
                                                <TextBlock Text="{Binding Loc[SwitchToPasswordLogin]}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="cfp-secondary" Command="{Binding SignOutSteamCommand}" IsVisible="{Binding IsSteamLoggedIn}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="LogOut" Size="16" />
                                                <TextBlock Text="{Binding Loc[SignOut]}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button Classes="cfp-link" Command="{Binding RefreshSteamNetworkCommand}" HorizontalAlignment="Left" MinHeight="36">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <LucideIcon Kind="RefreshCw" Size="14" />
                                    <TextBlock Text="{Binding Loc[RefreshSteamNetwork]}" />
                                </StackPanel>
                            </Button>
                            <Border Classes="cfp-download-qr" IsVisible="{Binding QrCodeImage, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                                <Image Width="180" Height="180" Source="{Binding QrCodeImage}" AutomationProperties.Name="{Binding Loc[SignInQr]}" />
                            </Border>
                            <Border Classes="cfp-download-qr" IsVisible="{Binding IsPasswordLoginVisible}">
                                <StackPanel Spacing="12" MaxWidth="480" HorizontalAlignment="Left">
                                    <TextBox Classes="cfp-input" Text="{Binding SteamUsername, Mode=TwoWay}" PlaceholderText="{Binding Loc[SteamUsername]}" MinWidth="320" AutomationProperties.Name="{Binding Loc[SteamUsername]}" />
                                    <TextBox Classes="cfp-input" Text="{Binding SteamPassword, Mode=TwoWay}" PasswordChar="●" PlaceholderText="{Binding Loc[SteamPassword]}" MinWidth="320" AutomationProperties.Name="{Binding Loc[SteamPassword]}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="cfp-primary" Command="{Binding SignInWithPasswordCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="LogIn" Size="16" />
                                                <TextBlock Text="{Binding Loc[SteamLogin]}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="cfp-link" Command="{Binding TogglePasswordLoginCommand}" MinHeight="36" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc[SwitchToQrLogin]}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="cfp-section-title" Text="{Binding Loc[GameVersions]}" />
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Classes="cfp-input" Text="{Binding DownloadBuildSearchText, Mode=TwoWay}" PlaceholderText="{Binding Loc[SearchGameVersions]}" AutomationProperties.Name="{Binding Loc[SearchGameVersions]}" />
                                    <Button Grid.Column="1" Classes="cfp-secondary" Click="ShowHistoricalManifestDownloadDialog" AutomationProperties.Name="{Binding Loc[OtherHistoricalVersion]}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <LucideIcon Kind="History" Size="16" />
                                            <TextBlock Text="{Binding Loc[OtherHistoricalVersion]}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ComboBox Classes="cfp-input cfp-download-build-filter" ItemsSource="{Binding VisibleDownloadBuilds}" SelectedItem="{Binding SelectedDownloadBuild, Mode=TwoWay}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Loc[GameVersions]}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DownloadBuildOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ListBox Classes="cfp-download-build-list" ItemsSource="{Binding VisibleDownloadBuilds}" SelectedItem="{Binding SelectedDownloadBuild, Mode=TwoWay}" IsVisible="{Binding VisibleDownloadBuilds.Count, Converter={x:Static converters:ObjectConverters.NotEqual}, ConverterParameter={StaticResource Zero}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DownloadBuildOption">
                                            <Grid Classes="cfp-download-build-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Classes="cfp-download-build-icon">
                                                    <LucideIcon Kind="HardDriveDownload" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="cfp-row-title" Text="{Binding DisplayName}" />
                                                    <TextBlock Classes="cfp-caption" Text="{Binding BuildId}" />
                                                </StackPanel>
                                                <LucideIcon Grid.Column="2" Kind="ChevronRight" Size="16" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Spacing="8" IsVisible="{Binding DownloadBuilds.Count, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}">
                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[NoDownloadBuildsAction]}" TextWrapping="Wrap" />
                                    <Button Classes="cfp-secondary" Command="{Binding SelectPageCommand}" CommandParameter="Settings" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <LucideIcon Kind="Settings" Size="16" />
                                            <TextBlock Text="{Binding Loc[OpenSettings]}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <ProgressBar x:Name="SteamDownloadProgress" Classes="cfp-progress" Minimum="0" Maximum="1" Value="{Binding DownloadProgress}" IsVisible="{Binding IsDownloading}" />
                                <TextBlock Classes="cfp-meta" Text="{Binding DownloadStatus}" TextWrapping="Wrap" />
                                <Button Classes="cfp-primary" Command="{Binding DownloadBuildCommand}" HorizontalAlignment="Left" IsVisible="{Binding IsDownloading, Converter={x:Static converters:BoolConverters.Not}}">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                            <Binding Path="IsSteamLoggedIn" />
                                            <Binding Path="SelectedDownloadBuild" Converter="{x:Static converters:ObjectConverters.IsNotNull}" />
                                            <Binding Path="IsBusy" Converter="{x:Static converters:BoolConverters.Not}" />
                                            <Binding Path="IsGameRunning" Converter="{x:Static converters:BoolConverters.Not}" />
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="Download" Size="16" />
                                        <TextBlock Text="{Binding Loc[NavDownloads]}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="cfp-secondary" Command="{Binding CancelDownloadCommand}" HorizontalAlignment="Left" IsVisible="{Binding IsDownloading}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="X" Size="16" />
                                        <TextBlock Text="{Binding Loc[Cancel]}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="1" Classes="cfp-subpage" IsVisible="{Binding IsModMarketDownloadSection}">
                        <Grid IsVisible="{Binding IsMarketList}" RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Margin="24,24,24,8" Spacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="cfp-page-title" Text="{Binding Loc[MarketTitle]}" />
                                    <TextBlock Classes="cfp-meta" Text="{Binding Loc[MarketHint]}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Classes="cfp-card cfp-market-source">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="cfp-row-title"
                                                   Text="{Binding OfficialModCatalogStatus}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="cfp-meta"
                                                   Text="{Binding OfficialModCatalogSummary}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Foreground="{DynamicResource CfErrorBrush}"
                                                   Text="{Binding OfficialModCatalogError}"
                                                   TextWrapping="Wrap"
                                                   Grid.ColumnSpan="2"
                                                   IsVisible="{Binding OfficialModCatalogError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                    </Grid>
                                </Border>
                                <TextBox Classes="cfp-input"
                                         Text="{Binding MarketSearchText, Mode=TwoWay}"
                                         PlaceholderText="{Binding Loc[MarketSearch]}"
                                         AutomationProperties.Name="{Binding Loc[MarketSearch]}" />
                                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8" Margin="0,4,0,-4">
                                    <TextBlock Grid.Column="0" Classes="cfp-caption" Text="{Binding Loc[MarketBuild]}" />
                                    <TextBlock Grid.Column="1" Classes="cfp-caption" Text="{Binding Loc[MarketLoader]}" />
                                    <TextBlock Grid.Column="2" Classes="cfp-caption" Text="{Binding Loc[MarketSource]}" />
                                    <TextBlock Grid.Column="3" Classes="cfp-caption" Text="{Binding Loc[MarketTag]}" />
                                    <TextBlock Grid.Column="4" Classes="cfp-caption" Text="{Binding Loc[MarketActivity]}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" Classes="cfp-input" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding MarketBuildOptions}"
                                              SelectedItem="{Binding SelectedMarketBuildOption, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Loc[MarketBuild]}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1" Classes="cfp-input" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding MarketLoaderOptions}"
                                              SelectedItem="{Binding SelectedMarketLoaderOption, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Loc[MarketLoader]}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" Classes="cfp-input" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding MarketSourceOptions}"
                                              SelectedItem="{Binding SelectedMarketSourceOption, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Loc[MarketSource]}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="3" Classes="cfp-input" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding MarketTagOptions}"
                                              SelectedItem="{Binding SelectedMarketTagOption, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Loc[MarketTag]}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="4" Classes="cfp-input" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding MarketActivityOptions}"
                                              SelectedItem="{Binding SelectedMarketActivityOption, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Loc[ActivityAll]}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="24,0,24,24">
                                <ListBox Classes="cfp-list cfp-market-list"
                                         ItemsSource="{Binding VisibleMarketDisplayMods}"
                                         AutomationProperties.Name="{Binding Loc[ModMarket]}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MarketModItemViewModel" x:CompileBindings="False">
                                            <Button Classes="cfp-market-item"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding #Root.DataContext.OpenMarketModCommand}"
                                                    CommandParameter="{Binding Manifest}"
                                                    AutomationProperties.Name="{Binding PrimaryName}">
                                                <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                                    <Border Width="32" Height="32" CornerRadius="8"
                                                            Classes="cfp-icon-tile">
                                                        <LucideIcon Kind="Package" Size="16"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="cfp-row-title" Text="{Binding PrimaryName}" TextTrimming="CharacterEllipsis" />
                                                        <WrapPanel Orientation="Horizontal">
                                                            <TextBlock Classes="cfp-caption"
                                                                       Margin="0,0,10,0"
                                                                       Text="{Binding SecondaryName}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding HasSecondaryName}" />
                                                            <TextBlock Classes="cfp-caption" Margin="0,0,10,0" Text="{Binding Version}" />
                                                            <TextBlock Classes="cfp-caption" Margin="0,0,10,0" Text="{Binding LoaderId}" />
                                                            <TextBlock Classes="cfp-caption" Text="{Binding SourceName}" />
                                                        </WrapPanel>
                                                        <ItemsControl ItemsSource="{Binding Tags}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate><Border Classes="cfp-badge cfp-market-tag" Margin="0,2,6,0"><TextBlock Classes="cfp-caption" Text="{Binding Name}" /></Border></DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <LucideIcon Grid.Column="2" Kind="ChevronRight" Size="16"
                                                                Foreground="{DynamicResource CfMutedTextBrush}"
                                                                VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Margin="24"
                                           Classes="cfp-meta"
                                           Text="{Binding Loc[MarketEmpty]}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding VisibleMarketDisplayMods.Count, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}" />
                            </Grid>
                        </Grid>

                        <ScrollViewer Classes="cfp-subpage"
                                      IsVisible="{Binding IsMarketDetail}"
                                      HorizontalContentAlignment="Stretch"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Classes="cfp-workspace" Margin="24" Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
                                <Button Classes="cfp-secondary"
                                        HorizontalAlignment="Left"
                                        Command="{Binding BackToMarketCommand}"
                                        AutomationProperties.Name="{Binding Loc[BackToMarket]}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="ArrowLeft" Size="16" />
                                        <TextBlock Text="{Binding Loc[BackToMarket]}" />
                                    </StackPanel>
                                </Button>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="cfp-page-title" Text="{Binding SelectedMarketModDisplay.PrimaryName}" TextWrapping="Wrap" />
                                        <TextBlock Classes="cfp-meta"
                                                   Text="{Binding SelectedMarketModDisplay.SecondaryName}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding SelectedMarketModDisplay.HasSecondaryName}" />
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Classes="cfp-meta" Margin="0,0,12,0" Text="{Binding SelectedMarketModDisplay.Version}" />
                                            <TextBlock Classes="cfp-meta" Margin="0,0,12,0" Text="{Binding SelectedMarketModDisplay.LoaderId}" />
                                            <TextBlock Classes="cfp-meta" Text="{Binding SelectedMarketModDisplay.SourceName}" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="cfp-primary"
                                            Click="OpenMarketInstallDialog"
                                            AutomationProperties.Name="{Binding Loc[InstallModTitle]}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <LucideIcon Kind="PackagePlus" Size="16" />
                                            <TextBlock Text="{Binding Loc[Install]}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <WrapPanel Classes="cfp-mod-detail-actions"
                                           Orientation="Horizontal"
                                           IsVisible="{Binding HasSelectedMarketModInstallation}">
                                    <Button Classes="cfp-secondary"
                                            Margin="0,0,8,8"
                                            Command="{Binding RepairSelectedMarketModCommand}"
                                            IsVisible="{Binding CanReinstallSelectedMarketMod}"
                                            AutomationProperties.Name="{Binding Loc[ReinstallMod]}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="RefreshCw" Size="15" />
                                            <TextBlock Text="{Binding Loc[ReinstallMod]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="cfp-secondary"
                                            Margin="0,0,8,8"
                                            Click="OpenSelectedMarketModFolder"
                                            AutomationProperties.Name="{Binding Loc[OpenFolder]}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="FolderOpen" Size="15" />
                                            <TextBlock Text="{Binding Loc[OpenFolder]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="cfp-secondary"
                                            Margin="0,0,8,8"
                                            Command="{Binding OpenSelectedModLogsCommand}"
                                            AutomationProperties.Name="{Binding Loc[OpenLogs]}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="FileText" Size="15" />
                                            <TextBlock Text="{Binding Loc[OpenLogs]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="cfp-secondary"
                                            Margin="0,0,8,8"
                                            Click="OpenSelectedModGlobalSettings"
                                            IsVisible="{Binding CanAccessSelectedModGlobalSettings}"
                                            AutomationProperties.Name="{Binding Loc[GlobalSettings]}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="Settings2" Size="15" />
                                            <TextBlock Text="{Binding Loc[GlobalSettings]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="cfp-danger"
                                            Margin="0,0,8,8"
                                            Click="ConfirmDeleteSelectedModGlobalSettings"
                                            IsVisible="{Binding HasSelectedModGlobalSettings}"
                                            AutomationProperties.Name="{Binding Loc[DeleteGlobalSettings]}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="Trash2" Size="15" />
                                            <TextBlock Text="{Binding Loc[DeleteGlobalSettings]}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <Border Classes="cfp-card" IsVisible="{Binding SelectedMarketModDisplay.HasPrimaryDescription}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding SelectedMarketModDisplay.PrimaryDescription}" TextWrapping="Wrap" />
                                        <StackPanel Spacing="4" IsVisible="{Binding SelectedMarketModDisplay.HasSecondaryDescription}">
                                            <TextBlock Classes="cfp-row-title" Text="{Binding Loc[OfficialEnglishDescription]}" />
                                            <TextBlock Classes="cfp-meta"
                                                       Text="{Binding SelectedMarketModDisplay.SecondaryDescription}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="cfp-card cfp-mod-content-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Classes="cfp-section-title"
                                                       Text="{Binding Loc[Readme]}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="cfp-caption"
                                                       Text="{Binding SelectedModContentStatusText}" />
                                        </Grid>
                                        <ProgressBar IsIndeterminate="True"
                                                     IsVisible="{Binding IsLoadingSelectedModContent}" />
                                        <TextBlock Classes="cfp-caption"
                                                   Foreground="{DynamicResource CfErrorBrush}"
                                                   Text="{Binding SelectedModContentError}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasSelectedModContentError}" />
                                        <mv:MarkdownViewer Markdown="{Binding SelectedModReadmeMarkdown}"
                                                           IsVisible="{Binding HasSelectedModReadme}" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="cfp-card cfp-mod-content-card"
                                        IsVisible="{Binding HasSelectedModReleaseNotes}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="cfp-section-title"
                                                   Text="{Binding Loc[LatestReleaseNotes]}" />
                                        <mv:MarkdownViewer Markdown="{Binding SelectedModReleaseNotesMarkdown}" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="140,*"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[Authors]}" /><ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedMarketModDisplay.Authors}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                                        <Grid ColumnDefinitions="140,*"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[Tags]}" /><ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedMarketModDisplay.Tags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Classes="cfp-badge cfp-market-tag" Margin="0,0,6,4"><TextBlock Classes="cfp-caption" Text="{Binding Name}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                                        <Grid ColumnDefinitions="140,*"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[Integrations]}" /><ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedMarketModDisplay.Integrations}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                                        <Grid ColumnDefinitions="140,*"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[SupportedBuilds]}" /><ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedMarketModDisplay.SupportedBuildIds}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                                        <Grid ColumnDefinitions="140,*"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[Dependencies]}" /><ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedMarketModDisplay.Dependencies}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                                        <Grid ColumnDefinitions="140,*" IsVisible="{Binding SelectedMarketModDisplay.HasRepositoryUrl}"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[Repository]}" /><Button Grid.Column="1" Classes="cfp-link" Tag="{Binding SelectedMarketModDisplay.RepositoryUrl}" Click="OpenExternalUrl" AutomationProperties.Name="{Binding Loc[Repository]}"><TextBlock Text="{Binding SelectedMarketModDisplay.RepositoryUrl}" TextWrapping="Wrap" /></Button></Grid>
                                        <Grid ColumnDefinitions="140,*" IsVisible="{Binding SelectedMarketModDisplay.HasIssuesUrl}"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[Issues]}" /><Button Grid.Column="1" Classes="cfp-link" Tag="{Binding SelectedMarketModDisplay.IssuesUrl}" Click="OpenExternalUrl" AutomationProperties.Name="{Binding Loc[Issues]}"><TextBlock Text="{Binding SelectedMarketModDisplay.IssuesUrl}" TextWrapping="Wrap" /></Button></Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer Grid.Column="1"
                                  Classes="cfp-subpage"
                                  IsVisible="{Binding IsDownloadQueueSection}"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="cfp-workspace"
                                    Margin="24"
                                    Spacing="16"
                                    MaxWidth="1200"
                                    HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="cfp-page-title" Text="{Binding Loc[DownloadQueue]}" />
                                <TextBlock Classes="cfp-meta"
                                           Text="{Binding Loc[DownloadQueueHint]}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="12"
                                        IsVisible="{Binding DownloadCenter.HasActiveDownloads}">
                                <TextBlock Classes="cfp-caption"
                                           Text="{Binding DownloadCenter.ActiveCountText}" />
                                <TextBlock Classes="cfp-caption"
                                           Text="{Binding DownloadCenter.TotalSpeedText}" />
                                <TextBlock Classes="cfp-caption"
                                           Text="{Binding DownloadCenter.OverallEtaText}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="cfp-secondary"
                                        Command="{Binding DownloadCenter.RetryAllCommand}"
                                        IsEnabled="{Binding DownloadCenter.CanRetryAll}"
                                        AutomationProperties.Name="{Binding Loc[QueueRetryAll]}"
                                        Content="{Binding Loc[QueueRetryAll]}" />
                                <Button Classes="cfp-secondary"
                                        Command="{Binding DownloadCenter.PauseAllCommand}"
                                        IsEnabled="{Binding DownloadCenter.CanPauseAll}"
                                        AutomationProperties.Name="{Binding Loc[QueuePauseAll]}"
                                        Content="{Binding Loc[QueuePauseAll]}" />
                                <Button Classes="cfp-secondary"
                                        Command="{Binding DownloadCenter.ResumeAllCommand}"
                                        IsEnabled="{Binding DownloadCenter.CanResumeAll}"
                                        AutomationProperties.Name="{Binding Loc[QueueResumeAll]}"
                                        Content="{Binding Loc[QueueResumeAll]}" />
                                <Button Classes="cfp-secondary"
                                        Command="{Binding DownloadCenter.ClearCompletedCommand}"
                                        IsEnabled="{Binding DownloadCenter.CanClearCompleted}"
                                        AutomationProperties.Name="{Binding Loc[QueueClearCompleted]}"
                                        Content="{Binding Loc[QueueClearCompleted]}" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <ItemsControl ItemsSource="{Binding DownloadCenter.DownloadQueueGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DownloadQueueGroupItemViewModel">
                                            <Border Classes="cfp-card" Margin="0,0,0,8">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Classes="cfp-row-title"
                                                                       Text="{Binding Name}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Classes="cfp-caption">
                                                                <TextBlock.TextWrapping>Wrap</TextBlock.TextWrapping>
                                                                <TextBlock.Inlines>
                                                                    <Run Text="{Binding #Root.DataContext.Loc[QueueTarget]}" />
                                                                    <Run Text=": " />
                                                                    <Run Text="{Binding TargetInstanceName}" />
                                                                    <Run Text=" · " />
                                                                    <Run Text="{Binding StageText}" />
                                                                </TextBlock.Inlines>
                                                            </TextBlock>
                                                            <TextBlock Classes="cfp-caption"
                                                                       Text="{Binding DurationText}"
                                                                       IsVisible="{Binding HasDuration}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Classes="cfp-secondary cfp-icon"
                                                                Width="44"
                                                                Height="44"
                                                                Command="{Binding #Root.DataContext.DownloadCenter.RetryQueuedDownloadCommand}"
                                                                CommandParameter="{Binding Id}"
                                                                ToolTip.Tip="{Binding #Root.DataContext.Loc[QueueRetry]}"
                                                                AutomationProperties.Name="{Binding #Root.DataContext.Loc[QueueRetry]}"
                                                                IsVisible="{Binding CanRetry}"
                                                                Content="{LucideIconContent RotateCcw, 16}" />
                                                        <Button Grid.Column="2"
                                                                Classes="cfp-secondary cfp-icon"
                                                                Width="44"
                                                                Height="44"
                                                                Command="{Binding #Root.DataContext.DownloadCenter.CancelQueuedDownloadCommand}"
                                                                CommandParameter="{Binding Id}"
                                                                ToolTip.Tip="{Binding #Root.DataContext.Loc[Cancel]}"
                                                                AutomationProperties.Name="{Binding #Root.DataContext.Loc[Cancel]}"
                                                                IsVisible="{Binding CanCancel}"
                                                                Content="{LucideIconContent X, 16}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <ProgressBar Minimum="0"
                                                                     Maximum="1"
                                                                     Value="{Binding Progress}"
                                                                     VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="cfp-caption" Text="{Binding ProgressText}" />
                                                            <TextBlock Classes="cfp-caption" Text="{Binding SpeedText}" />
                                                            <TextBlock Classes="cfp-caption" Text="{Binding EtaText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                          ColumnSpacing="8"
                                                          IsVisible="{Binding HasError}">
                                                        <Border Classes="cfp-badge" VerticalAlignment="Top">
                                                            <TextBlock Classes="cfp-caption"
                                                                       Text="{Binding ErrorCategoryText}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="cfp-caption"
                                                                   Foreground="{DynamicResource CfErrorBrush}"
                                                                   Text="{Binding Error}"
                                                                   TextWrapping="Wrap" />
                                                        <Button Grid.Column="2"
                                                                Classes="cfp-secondary cfp-icon"
                                                                Width="32"
                                                                Height="32"
                                                                Command="{Binding CopyErrorCommand}"
                                                                ToolTip.Tip="{Binding #Root.DataContext.Loc[QueueCopyError]}"
                                                                AutomationProperties.Name="{Binding #Root.DataContext.Loc[QueueCopyError]}"
                                                                Content="{LucideIconContent Copy, 15}" />
                                                    </Grid>
                                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                        <Expander.Header>
                                                            <TextBlock Classes="cfp-caption"
                                                                       Text="{Binding #Root.DataContext.Loc[QueueDetails]}" />
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:DownloadQueueItemViewModel">
                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                          ColumnSpacing="12"
                                                                          Margin="0,4">
                                                                        <StackPanel Spacing="4">
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       TextWrapping="Wrap" />
                                                                            <TextBlock Classes="cfp-caption">
                                                                                <TextBlock.TextWrapping>Wrap</TextBlock.TextWrapping>
                                                                                <TextBlock.Inlines>
                                                                                    <Run Text="{Binding Version}" />
                                                                                    <Run Text=" · " />
                                                                                    <Run Text="{Binding StageText}" />
                                                                                </TextBlock.Inlines>
                                                                            </TextBlock>
                                                                            <TextBlock Classes="cfp-caption"
                                                                                       Foreground="{DynamicResource CfErrorBrush}"
                                                                                       Text="{Binding Error}"
                                                                                       TextWrapping="Wrap"
                                                                                       IsVisible="{Binding HasError}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1"
                                                                                    HorizontalAlignment="Right"
                                                                                    Spacing="4">
                                                                            <TextBlock Classes="cfp-caption"
                                                                                       Text="{Binding ProgressText}"
                                                                                       TextAlignment="Right" />
                                                                            <TextBlock Classes="cfp-caption"
                                                                                       Text="{Binding SpeedText}"
                                                                                       TextAlignment="Right" />
                                                                            <TextBlock Classes="cfp-caption"
                                                                                       Text="{Binding RetryText}"
                                                                                       TextAlignment="Right"
                                                                                       IsVisible="{Binding HasRetries}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="12"
                                            HorizontalAlignment="Center"
                                            Margin="24"
                                            IsVisible="{Binding DownloadCenter.DownloadQueueGroups.Count, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}">
                                    <TextBlock Classes="cfp-meta"
                                               MaxWidth="480"
                                               Text="{Binding Loc[DownloadQueueEmpty]}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Spacing="8">
                                        <Button Classes="cfp-secondary"
                                                Command="{Binding SelectDownloadSectionCommand}"
                                                CommandParameter="GameVersions"
                                                Content="{Binding Loc[GameVersions]}" />
                                        <Button Classes="cfp-secondary"
                                                Command="{Binding SelectDownloadSectionCommand}"
                                                CommandParameter="ModMarket"
                                                Content="{Binding Loc[ModMarket]}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Settings -->
            <Grid Classes="cfp-page" IsVisible="{Binding IsSettingsPage}">
                <Grid Classes="cfp-settings-layout" ColumnDefinitions="176,*">
                    <Border Grid.Column="0" Classes="cfp-rail" Padding="8,16">
                        <StackPanel Classes="cfp-manage-nav" Spacing="4" IsEnabled="{Binding CanNavigate}">
                            <Button Classes="cfp-local-nav" Classes.active="{Binding Settings.IsGeneralSettingsSection}" Command="{Binding Settings.SelectSettingsSectionCommand}" CommandParameter="General">
                                <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Settings2" Size="16" /><TextBlock Text="{Binding Loc[SettingsGeneral]}" /></StackPanel>
                            </Button>
                            <Button Classes="cfp-local-nav" Classes.active="{Binding Settings.IsNetworkSettingsSection}" Command="{Binding Settings.SelectSettingsSectionCommand}" CommandParameter="Network">
                                <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Gauge" Size="16" /><TextBlock Text="{Binding Loc[SettingsNetwork]}" /></StackPanel>
                            </Button>
                            <Button Classes="cfp-local-nav" Classes.active="{Binding Settings.IsCatalogSettingsSection}" Command="{Binding Settings.SelectSettingsSectionCommand}" CommandParameter="Catalog">
                                <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Store" Size="16" /><TextBlock Text="{Binding Loc[SettingsCatalog]}" /></StackPanel>
                            </Button>
                            <Button Classes="cfp-local-nav" Classes.active="{Binding Settings.IsUpdatesSettingsSection}" Command="{Binding Settings.SelectSettingsSectionCommand}" CommandParameter="Updates">
                                <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="RefreshCw" Size="16" /><TextBlock Text="{Binding Loc[SettingsUpdates]}" /></StackPanel>
                            </Button>
                            <Button Classes="cfp-local-nav" Classes.active="{Binding Settings.IsAboutSettingsSection}" Command="{Binding Settings.SelectSettingsSectionCommand}" CommandParameter="About">
                                <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Info" Size="16" /><TextBlock Text="{Binding Loc[SettingsAbout]}" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="cfp-workspace cfp-settings-workspace"
                                    Margin="24"
                                    Spacing="16"
                                    MaxWidth="1200"
                                    HorizontalAlignment="Stretch">
                            <StackPanel Spacing="16" Classes="cfp-subpage" IsVisible="{Binding Settings.IsGeneralSettingsSection}">
                                <Border Classes="cfp-card">
                                    <Grid ColumnDefinitions="*,16,*,16,*">
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <TextBlock Classes="cfp-row-title" Text="{Binding Loc[Language]}" />
                                            <ComboBox Classes="cfp-input" ItemsSource="{Binding Settings.LanguageOptions}" SelectedItem="{Binding Settings.SelectedLanguage, Mode=TwoWay}" AutomationProperties.Name="{Binding Loc[Language]}">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="8">
                                            <TextBlock Classes="cfp-row-title" Text="{Binding Loc[Theme]}" />
                                            <ComboBox Classes="cfp-input" ItemsSource="{Binding Settings.ThemeOptions}" SelectedItem="{Binding Settings.SelectedTheme, Mode=TwoWay}" AutomationProperties.Name="{Binding Loc[Theme]}">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Spacing="8">
                                            <TextBlock Classes="cfp-row-title" Text="{Binding Loc[Motion]}" />
                                            <ComboBox Classes="cfp-input" ItemsSource="{Binding Settings.MotionOptions}" SelectedItem="{Binding Settings.SelectedMotionPreference, Mode=TwoWay}" AutomationProperties.Name="{Binding Loc[Motion]}">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="cfp-row-title" Text="{Binding Loc[AccentColor]}" />
                                        <ItemsControl ItemsSource="{Binding Settings.AccentColorOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AccentColorOptionViewModel">
                                                    <Button Classes="cfp-accent-swatch"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Click="OnAccentColorClicked"
                                                            AutomationProperties.Name="{Binding Name}"
                                                            ToolTip.Tip="{Binding Name}">
                                                        <Grid Width="24" Height="24">
                                                            <Border CornerRadius="12"
                                                                    Background="{Binding SwatchBrush}"
                                                                    IsVisible="{Binding IsCustom, Converter={x:Static converters:BoolConverters.Not}}" />
                                                            <Border CornerRadius="12"
                                                                    IsVisible="{Binding IsCustom}">
                                                                <Border.Background>
                                                                    <ConicGradientBrush Center="50%,50%">
                                                                        <GradientStop Color="#F04444" Offset="0" />
                                                                        <GradientStop Color="#F59E0B" Offset="0.17" />
                                                                        <GradientStop Color="#22C55E" Offset="0.34" />
                                                                        <GradientStop Color="#06B6D4" Offset="0.51" />
                                                                        <GradientStop Color="#3B82F6" Offset="0.68" />
                                                                        <GradientStop Color="#A855F7" Offset="0.85" />
                                                                        <GradientStop Color="#F04444" Offset="1" />
                                                                    </ConicGradientBrush>
                                                                </Border.Background>
                                                                <Border Width="10"
                                                                        Height="10"
                                                                        CornerRadius="5"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        BorderBrush="White"
                                                                        BorderThickness="1"
                                                                        Background="{Binding SwatchBrush}" />
                                                            </Border>
                                                            <Border Width="16"
                                                                    Height="16"
                                                                    CornerRadius="8"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource CfOnAccentBrush}"
                                                                    IsVisible="{Binding IsSelected}">
                                                                <LucideIcon Kind="Check"
                                                                            Size="11"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Foreground="{DynamicResource CfAccentBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="cfp-caption" Text="{Binding Loc[AccentColorHint]}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card"
                                        AutomationProperties.Name="{Binding Loc[BackgroundImage]}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="cfp-row-title" Text="{Binding Loc[BackgroundImage]}" />
                                                <TextBlock Classes="cfp-caption"
                                                           Text="{Binding Loc[BackgroundImageHint]}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Classes="cfp-secondary cfp-background-scope"
                                                        Classes.active="{Binding Settings.IsEditingInstanceBackground, Converter={x:Static converters:BoolConverters.Not}}"
                                                        Click="OnGlobalBackgroundScopeClicked"
                                                        ToolTip.Tip="{Binding Loc[BackgroundScopeGlobalHint]}"
                                                        AutomationProperties.Name="{Binding Loc[BackgroundScopeGlobal]}"
                                                        Content="{Binding Loc[BackgroundScopeGlobal]}" />
                                                <Button Classes="cfp-secondary cfp-background-scope"
                                                        Classes.active="{Binding Settings.IsEditingInstanceBackground}"
                                                        IsEnabled="{Binding Settings.CanEditInstanceBackground}"
                                                        Click="OnInstanceBackgroundScopeClicked"
                                                        ToolTip.Tip="{Binding Loc[BackgroundScopeInstanceHint]}"
                                                        AutomationProperties.Name="{Binding Loc[BackgroundScopeInstance]}"
                                                        Content="{Binding Loc[BackgroundScopeInstance]}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="320,*" ColumnSpacing="16">
                                            <Border Width="320"
                                                    Height="180"
                                                    CornerRadius="7"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource CfWindowBrush}"
                                                    BorderBrush="{DynamicResource CfBorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Settings.BackgroundPreviewImage}"
                                                           Opacity="{Binding Settings.BackgroundPreviewOpacity}"
                                                           Stretch="UniformToFill"
                                                           IsHitTestVisible="False" />
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="6"
                                                                IsVisible="{Binding Settings.HasBackgroundPreviewImage, Converter={x:Static converters:BoolConverters.Not}}">
                                                        <LucideIcon Kind="Image" Size="24" Foreground="{DynamicResource CfMutedTextBrush}" />
                                                        <TextBlock Classes="cfp-caption" Text="{Binding Loc[BackgroundPreviewEmpty]}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="cfp-row-title" Text="{Binding Settings.BackgroundInstanceName}" />
                                                    <TextBlock Classes="cfp-caption" Text="{Binding Settings.BackgroundScopeStatus}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Classes="cfp-accent"
                                                            Click="OnSelectBackgroundImageClicked"
                                                            ToolTip.Tip="{Binding Loc[BackgroundSelectHint]}"
                                                            AutomationProperties.Name="{Binding Loc[BackgroundSelect]}">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <LucideIcon Kind="ImagePlus" Size="15" />
                                                            <TextBlock Text="{Binding Loc[BackgroundSelect]}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="cfp-secondary"
                                                            IsEnabled="{Binding Settings.CanRemoveBackgroundImage}"
                                                            Click="OnRemoveBackgroundImageClicked"
                                                            ToolTip.Tip="{Binding Settings.BackgroundRemoveLabel}"
                                                            AutomationProperties.Name="{Binding Settings.BackgroundRemoveLabel}"
                                                            Content="{Binding Settings.BackgroundRemoveLabel}" />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <Slider Minimum="0"
                                                            Maximum="100"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="True"
                                                            IsEnabled="{Binding Settings.CanChangeBackgroundOpacity}"
                                                            Value="{Binding Settings.BackgroundOpacityPercent, Mode=TwoWay}"
                                                            ToolTip.Tip="{Binding Loc[BackgroundOpacityHint]}"
                                                            AutomationProperties.Name="{Binding Loc[BackgroundOpacity]}" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="cfp-meta"
                                                               MinWidth="38"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Settings.BackgroundOpacityPercent, StringFormat={}{0:0}%}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="cfp-row-title" Text="{Binding Loc[OnboardingSection]}" />
                                            <TextBlock Classes="cfp-caption"
                                                       Text="{Binding Loc[OnboardingSectionHint]}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="cfp-secondary" MinHeight="36"
                                                Command="{Binding ShowOnboardingCommand}"
                                                AutomationProperties.Name="{Binding Loc[OnboardingReopen]}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <LucideIcon Kind="GraduationCap" Size="15" />
                                                <TextBlock Text="{Binding Loc[OnboardingReopen]}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="16" Classes="cfp-subpage" IsVisible="{Binding Settings.IsNetworkSettingsSection}">
                                <Border Classes="cfp-card">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[OfflineMode]}" /><TextBlock Classes="cfp-caption" Text="{Binding Loc[OfflineModeHint]}" TextWrapping="Wrap" /></StackPanel>
                                        <CheckBox Grid.Column="1" VerticalAlignment="Center" Content="{Binding Loc[OfflineMode]}" IsChecked="{Binding IsOfflineMode, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Classes="cfp-card cfp-github-route-card">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="3"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[GitHubRoute]}" /><TextBlock Classes="cfp-caption" Text="{Binding Loc[GitHubRouteHint]}" TextWrapping="Wrap" /></StackPanel>
                                            <ComboBox Grid.Column="1" Width="190" Classes="cfp-input" ItemsSource="{Binding Settings.GitHubRouteOptions}" SelectedItem="{Binding Settings.SelectedGitHubRoute, Mode=TwoWay}" AutomationProperties.Name="{Binding Loc[GitHubRoute]}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                            <Border Classes="cfp-latency-result"><StackPanel Spacing="2"><TextBlock Classes="cfp-caption" Text="{Binding Loc[GitHubDirect]}" /><TextBlock Classes="cfp-row-title" Text="{Binding Settings.GitHubDirectLatency}" /></StackPanel></Border>
                                            <Border Grid.Column="1" Classes="cfp-latency-result"><StackPanel Spacing="2"><TextBlock Classes="cfp-caption" Text="{Binding Loc[GitHubGhProxyOrg]}" /><TextBlock Classes="cfp-row-title" Text="{Binding Settings.GitHubGhProxyOrgLatency}" /></StackPanel></Border>
                                            <Border Grid.Column="2" Classes="cfp-latency-result"><StackPanel Spacing="2"><TextBlock Classes="cfp-caption" Text="{Binding Loc[GitHubMirror]}" /><TextBlock Classes="cfp-row-title" Text="{Binding Settings.GitHubMirrorLatency}" /></StackPanel></Border>
                                            <Border Grid.Row="1" Classes="cfp-latency-result"><StackPanel Spacing="2"><TextBlock Classes="cfp-caption" Text="{Binding Loc[GitHubGhProxyNet]}" /><TextBlock Classes="cfp-row-title" Text="{Binding Settings.GitHubGhProxyNetLatency}" /></StackPanel></Border>
                                            <Border Grid.Row="1" Grid.Column="1" Classes="cfp-latency-result"><StackPanel Spacing="2"><TextBlock Classes="cfp-caption" Text="{Binding Loc[GitHubGhFastTop]}" /><TextBlock Classes="cfp-row-title" Text="{Binding Settings.GitHubGhFastTopLatency}" /></StackPanel></Border>
                                            <Button Grid.Row="1" Grid.Column="2" Classes="cfp-secondary" Command="{Binding Settings.TestGitHubLatencyCommand}" IsEnabled="{Binding Settings.IsTestingGitHubLatency, Converter={x:Static converters:BoolConverters.Not}}"><StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Gauge" Size="15" /><TextBlock Text="{Binding Loc[TestLatency]}" /></StackPanel></Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="16" Classes="cfp-subpage" IsVisible="{Binding Settings.IsCatalogSettingsSection}">
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2"><TextBlock Classes="cfp-section-title" Text="{Binding Loc[HKModLinks]}" /><TextBlock Classes="cfp-caption" Text="{Binding Loc[HKModLinksHint]}" /></StackPanel>
                                            <TextBlock Grid.Column="1" Classes="cfp-row-title" Text="{Binding OfficialModCatalogStatus}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Classes="cfp-meta" Text="{Binding OfficialModCatalogSummary}" TextWrapping="Wrap" />
                                        <TextBlock Classes="cfp-meta" Text="{Binding OfficialModCatalogError}" Foreground="{DynamicResource CfErrorBrush}" TextWrapping="Wrap" IsVisible="{Binding OfficialModCatalogError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[CustomModLinks]}" />
                                        <TextBlock Classes="cfp-caption" Text="{Binding Loc[CustomModLinksHint]}" TextWrapping="Wrap" />
                                        <TextBox Classes="cfp-input" Text="{Binding Settings.CustomModLinksUrl, Mode=TwoWay}" PlaceholderText="https://example.invalid/ModLinks.xml" AutomationProperties.Name="{Binding Loc[CustomModLinks]}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <ComboBox Classes="cfp-input" ItemsSource="{Binding Settings.CustomModLinksBuildOptions}" SelectedItem="{Binding Settings.SelectedCustomModLinksBuild, Mode=TwoWay}" AutomationProperties.Name="{Binding Loc[MarketBuild]}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                            <ComboBox Grid.Column="1" Classes="cfp-input" ItemsSource="{Binding Settings.CustomModLinksLoaderOptions}" SelectedItem="{Binding Settings.SelectedCustomModLinksLoader, Mode=TwoWay}" AutomationProperties.Name="{Binding Loc[MarketLoader]}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                        </Grid>
                                        <Button Classes="cfp-accent" Command="{Binding Settings.SaveCustomModLinksCommand}" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Save" Size="16" /><TextBlock Text="{Binding Loc[Save]}" /></StackPanel></Button>
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[CustomCatalogSources]}" />
                                        <TextBox Classes="cfp-input" Text="{Binding Settings.CustomSourcesText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="120" AutomationProperties.Name="{Binding Loc[CustomCatalogSources]}" TextWrapping="NoWrap" />
                                        <Button Classes="cfp-accent" Command="{Binding Settings.SaveCustomSourcesCommand}" HorizontalAlignment="Right">
                                            <Button.IsEnabled><MultiBinding Converter="{x:Static converters:BoolConverters.And}"><Binding Path="IsBusy" Converter="{x:Static converters:BoolConverters.Not}" /><Binding Path="IsGameRunning" Converter="{x:Static converters:BoolConverters.Not}" /></MultiBinding></Button.IsEnabled>
                                            <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Save" Size="16" /><TextBlock Text="{Binding Loc[Save]}" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="16" Classes="cfp-subpage" IsVisible="{Binding Settings.IsUpdatesSettingsSection}">
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="3"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[ApplicationUpdates]}" /><TextBlock Classes="cfp-caption" Text="{Binding Loc[ApplicationUpdatesHint]}" TextWrapping="Wrap" /></StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Content="{Binding Loc[CheckForUpdates]}" IsChecked="{Binding IsAutomaticUpdateCheckEnabled, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Classes="cfp-meta" Text="{Binding ApplicationUpdateStatus}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="cfp-secondary" Click="OnCheckForApplicationUpdatesClick" IsEnabled="{Binding IsCheckingForApplicationUpdates, Converter={x:Static converters:BoolConverters.Not}}" AutomationProperties.Name="{Binding Loc[CheckNow]}"><StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="RefreshCw" Size="15" /><TextBlock Text="{Binding Loc[CheckNow]}" /></StackPanel></Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card" IsVisible="{Binding HasAvailableApplicationUpdate}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="cfp-section-title" Text="{Binding Loc[LatestApplicationReleaseNotes]}" />
                                                <TextBlock Classes="cfp-row-title" Text="{Binding AvailableApplicationUpdate.Version, StringFormat='v{0}'}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Classes="cfp-meta"
                                                       Text="{Binding AvailableApplicationUpdate.PublishedAt, StringFormat='{}{0:g}'}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                            <mv:MarkdownViewer Markdown="{Binding AvailableApplicationReleaseNotesMarkdown}" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="cfp-section-title" Text="{Binding Loc[CurrentReleaseNotes]}" />
                                            <TextBlock Classes="cfp-row-title" Text="{Binding ApplicationVersion, StringFormat='v{0}'}" />
                                        </StackPanel>
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                            <mv:MarkdownViewer Markdown="{Binding CurrentApplicationReleaseNotesMarkdown}" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[ProtocolRegistration]}" /><TextBlock Classes="cfp-caption" Text="{Binding Loc[ProtocolRegistrationHint]}" TextWrapping="Wrap" /></StackPanel>
                                        <TextBlock Grid.Column="1" Classes="cfp-row-title" Text="{Binding ProtocolRegistrationStatus}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="16" Classes="cfp-subpage" IsVisible="{Binding Settings.IsAboutSettingsSection}">
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="16">
                                        <StackPanel Spacing="4"><TextBlock Classes="cfp-section-title" Text="{Binding Loc[AboutTitle]}" /><TextBlock Classes="cfp-meta" Text="{Binding Loc[AboutDescription]}" TextWrapping="Wrap" /></StackPanel>
                                        <Button Classes="cfp-link" HorizontalAlignment="Left" MinHeight="36" Command="{Binding ShowOnboardingCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <LucideIcon Kind="GraduationCap" Size="14" />
                                                <TextBlock Text="{Binding Loc[OnboardingReopen]}" />
                                            </StackPanel>
                                        </Button>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[AboutContributors]}" /><TextBlock Grid.Column="1" Text="{Binding Loc[AboutContributorValue]}" TextWrapping="Wrap" /></Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[ProjectRepository]}" /><Button Grid.Column="1" Classes="cfp-link" Tag="https://github.com/wzxnb2333/Crystalfly" Click="OpenExternalUrl" AutomationProperties.Name="{Binding Loc[ProjectRepository]}"><TextBlock Text="https://github.com/wzxnb2333/Crystalfly" TextWrapping="Wrap" /></Button></Grid>
                                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12"><TextBlock Classes="cfp-row-title" Text="{Binding Loc[OpenSourceLicense]}" /><TextBlock Grid.Column="1" Text="{Binding Loc[LicenseName]}" TextWrapping="Wrap" /></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[AboutDesignReferences]}" />
                                        <TextBlock Classes="cfp-caption" Text="{Binding Loc[AboutDesignReferencesDescription]}" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/Hex-Dragon/PCL2" Click="OpenExternalUrl"><TextBlock Text="PCL2" /></Button>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/TheMulhima/Lumafly" Click="OpenExternalUrl"><TextBlock Text="Lumafly" /></Button>
                                            <Button Classes="cfp-link" Tag="https://github.com/fifty-six/Scarab" Click="OpenExternalUrl"><TextBlock Text="Scarab" /></Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[AboutOpenSourceComponents]}" />
                                        <TextBlock Classes="cfp-caption" Text="{Binding Loc[AboutOpenSourceComponentsDescription]}" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/AvaloniaUI/Avalonia" Click="OpenExternalUrl"><TextBlock Text="Avalonia" /></Button>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/irihitech/Semi.Avalonia" Click="OpenExternalUrl"><TextBlock Text="Semi.Avalonia" /></Button>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/irihitech/Ursa.Avalonia" Click="OpenExternalUrl"><TextBlock Text="Ursa" /></Button>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/SteamRE/SteamKit" Click="OpenExternalUrl"><TextBlock Text="SteamKit2" /></Button>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/dme-compunet/Lucide.Avalonia" Click="OpenExternalUrl"><TextBlock Text="Lucide.Avalonia" /></Button>
                                            <Button Classes="cfp-link" Tag="https://github.com/Kryptos-FR/MarkView.Avalonia" Click="OpenExternalUrl"><TextBlock Text="MarkView.Avalonia" /></Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[AboutSpeedrunSources]}" />
                                        <TextBlock Classes="cfp-caption" Text="{Binding Loc[AboutSpeedrunSourcesDescription]}" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/hk-speedrunning" Click="OpenExternalUrl"><TextBlock Text="HK Speedrunning" /></Button>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/hk-speedrunning/HK-Resources" Click="OpenExternalUrl"><TextBlock Text="HK-Resources" /></Button>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/olvior/AssemblyPatches/releases/tag/v1.0.2" Click="OpenExternalUrl"><TextBlock Text="AssemblyPatches v1.0.2" /></Button>
                                            <Button Classes="cfp-link" Margin="0,0,12,0" Tag="https://github.com/Shichien/MiniSavestates" Click="OpenExternalUrl"><TextBlock Text="MiniSaveStates" /></Button>
                                            <Button Classes="cfp-link" Tag="https://www.speedrun.com" Click="OpenExternalUrl"><TextBlock Text="Speedrun.com" /></Button>
                                        </WrapPanel>
                                        <TextBlock Classes="cfp-row-title" Text="{Binding Loc[AboutSpeedrunComData]}" />
                                        <TextBlock Classes="cfp-caption" Text="{Binding Loc[AboutSpeedrunComDataDescription]}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="cfp-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="cfp-section-title" Text="{Binding Loc[AboutModCatalogAndTranslations]}" />
                                        <TextBlock Classes="cfp-caption" Text="{Binding Loc[AboutModCatalogAndTranslationsDescription]}" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <Button Classes="cfp-link" Tag="https://github.com/hk-modding/modlinks" Click="OpenExternalUrl"><TextBlock Text="HK ModLinks" /></Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
        </u:LoadingContainer>
        <Button Grid.Row="2" Classes="cfp-download-fab cfp-primary" Width="44" Height="44" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding OpenDownloadQueueCommand}" ToolTip.Tip="{Binding DownloadCenter.ActiveDownloadSummary}" AutomationProperties.Name="{Binding Loc[DownloadQueue]}" IsVisible="{Binding DownloadCenter.HasActiveDownloads}" Content="{LucideIconContent Download, 18}" />
        <u:OverlayDialogHost x:Name="MainOverlayDialogHost"
                             Grid.RowSpan="3"
                             HostId="Crystalfly.Main" />
    </Grid>
</Window>

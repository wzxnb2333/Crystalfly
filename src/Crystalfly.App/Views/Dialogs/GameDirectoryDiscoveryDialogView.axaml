<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Crystalfly.App.ViewModels.Dialogs" xmlns:item="using:Crystalfly.App.ViewModels" xmlns:u="https://irihi.tech/ursa" x:Class="Crystalfly.App.Views.Dialogs.GameDirectoryDiscoveryDialogView" x:DataType="vm:GameDirectoryDiscoveryDialogViewModel" MinWidth="520" MaxWidth="680">
  <UserControl.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding SkipCommand}" /></UserControl.KeyBindings>
  <StackPanel Margin="24" Spacing="16">
    <StackPanel Spacing="4"><TextBlock Classes="cfp-section-title" Text="{Binding Title}"/><TextBlock Classes="cfp-meta" Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel>
    <Border Classes="cfp-list-frame" MaxHeight="280" IsVisible="{Binding HasCandidates}"><ListBox ItemsSource="{Binding Candidates}"><ListBox.ItemTemplate><DataTemplate x:DataType="item:GameDirectoryCandidateItemViewModel"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="8,5"><CheckBox IsChecked="{Binding IsConfirmed, Mode=TwoWay}" AutomationProperties.Name="{Binding DisplayName}"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Classes="cfp-row-title" Text="{Binding DisplayName}"/><TextBlock Classes="cfp-caption" Text="{Binding Path}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8"><Button Classes="cfp-secondary" Command="{Binding ScanCommand}" Content="{Binding ScanText}"/><Button Grid.Column="1" Classes="cfp-secondary" Command="{Binding AddCustomCommand}" Content="{Binding AddText}"/><Button Grid.Column="3" Classes="cfp-secondary" Command="{Binding SkipCommand}" Content="{Binding SkipText}" u:FocusHelper.DialogFocusHint="True"/><Button Grid.Column="4" Classes="cfp-accent" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsVisible="{Binding HasCandidates}"/></Grid>
  </StackPanel>
</UserControl>
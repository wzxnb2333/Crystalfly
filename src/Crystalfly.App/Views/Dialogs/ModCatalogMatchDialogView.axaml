<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Crystalfly.App.ViewModels.Dialogs"
             xmlns:models="using:Crystalfly.Core.Models"
             x:Class="Crystalfly.App.Views.Dialogs.ModCatalogMatchDialogView"
             x:DataType="vm:ModCatalogMatchDialogViewModel"
             Width="520"
             MinWidth="440"
             MaxWidth="640">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </UserControl.KeyBindings>

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
        <TextBlock Classes="cfp-section-title"
                   Text="{Binding Title}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="1"
                   Text="{Binding Message}"
                   TextWrapping="Wrap" />
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Candidates}"
                 SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                 MaxHeight="280"
                 AutomationProperties.Name="{Binding Title}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ModManifest">
                    <StackPanel Spacing="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Classes="cfp-meta" Text="{Binding Version}" />
                        <TextBlock Classes="cfp-meta" Text="{Binding LoaderId}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Classes="cfp-secondary"
                    Command="{Binding CancelCommand}"
                    Content="{Binding CancelText}"
                    MinWidth="96"
                    AutomationProperties.Name="{Binding CancelText}" />
            <Button Classes="cfp-primary"
                    Command="{Binding ConfirmCommand}"
                    Content="{Binding ConfirmText}"
                    IsEnabled="{Binding CanConfirm}"
                    MinWidth="96"
                    AutomationProperties.Name="{Binding ConfirmText}" />
        </StackPanel>
    </Grid>
</UserControl>

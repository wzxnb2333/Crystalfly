<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Crystalfly.App.ViewModels.Dialogs" xmlns:converters="using:Avalonia.Data.Converters" xmlns:u="https://irihi.tech/ursa" x:Class="Crystalfly.App.Views.Dialogs.SteamInstanceDeletionDialogView" x:DataType="vm:ThreeChoiceDialogViewModel" MinWidth="460" MaxWidth="620"><UserControl.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/></UserControl.KeyBindings><StackPanel Margin="24" Spacing="16"><TextBlock Classes="cfp-section-title" Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Classes="cfp-meta" Text="{Binding Target}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="cfp-secondary" Command="{Binding CancelCommand}" Content="{Binding CancelText}" u:FocusHelper.DialogFocusHint="True"/><Button Classes="cfp-secondary" Command="{Binding SecondaryCommand}" Content="{Binding SecondaryText}"/><Button Classes.cfp-danger="{Binding PrimaryDangerous}" Classes.cfp-accent="{Binding PrimaryDangerous, Converter={x:Static converters:BoolConverters.Not}}" Command="{Binding PrimaryCommand}" Content="{Binding PrimaryText}"/></StackPanel></StackPanel></UserControl>
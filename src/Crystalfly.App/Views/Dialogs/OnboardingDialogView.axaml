<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Crystalfly.App.ViewModels.Dialogs"
             x:Class="Crystalfly.App.Views.Dialogs.OnboardingDialogView"
             x:DataType="vm:OnboardingDialogViewModel"
             Width="560"
             MinWidth="480"
             MaxWidth="680">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding SkipCommand}" />
    </UserControl.KeyBindings>

    <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
        <StackPanel Spacing="4">
            <TextBlock Classes="cfp-section-title" Text="{Binding CurrentTitle}" TextWrapping="Wrap" />
            <TextBlock Classes="cfp-caption" Text="{Binding StepPosition}" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="{Binding CurrentDescription}"
                   TextWrapping="Wrap"
                   MinHeight="96" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="cfp-secondary"
                        Command="{Binding BackCommand}"
                        Content="{Binding BackText}"
                        IsEnabled="{Binding CanGoBack}"
                        MinWidth="96"
                        AutomationProperties.Name="{Binding BackText}" />
                <Button Classes="cfp-secondary"
                        Command="{Binding SkipCommand}"
                        Content="{Binding SkipText}"
                        MinWidth="96"
                        AutomationProperties.Name="{Binding SkipText}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="cfp-primary" MinWidth="120"
                    Command="{Binding NextCommand}"
                    Content="{Binding NextText}"
                    AutomationProperties.Name="{Binding NextText}" />
        </Grid>
    </Grid>
</UserControl>

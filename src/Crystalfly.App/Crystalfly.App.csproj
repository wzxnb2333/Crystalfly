<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\crystalfly-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Updates\stable-1.pub" LogicalName="Crystalfly.App.Updates.stable-1.pub" />
    <EmbeddedResource Include="..\..\docs\releases\*.md"
                      LogicalName="Crystalfly.App.ReleaseNotes.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sentry" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="Lucide.Avalonia" />
    <PackageReference Include="MarkView.Avalonia" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Semi.Avalonia.ColorPicker" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crystalfly.Core\Crystalfly.Core.csproj" />
    <ProjectReference Include="..\Crystalfly.Steam\Crystalfly.Steam.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Crystalfly.App.Tests" />
    <InternalsVisibleTo Include="Crystalfly.Diagnostics.Probe" />
  </ItemGroup>

  <ItemGroup Condition="'$(CrystalflyErrorReportingDsn)' != ''">
    <AssemblyMetadata Include="ErrorReportingDsn" Value="$(CrystalflyErrorReportingDsn)" />
    <AssemblyMetadata Include="ErrorReportingRegion" Value="$(CrystalflyErrorReportingRegion)" />
    <AssemblyMetadata Include="ErrorReportingRetention" Value="$(CrystalflyErrorReportingRetention)" />
  </ItemGroup>
  <Target Name="ValidateErrorReportingMetadata" BeforeTargets="GenerateAssemblyInfo"
          Condition="'$(CrystalflyErrorReportingDsn)' != ''">
    <Error Condition="'$(CrystalflyErrorReportingRegion)' == '' Or '$(CrystalflyErrorReportingRetention)' == ''"
           Text="Error reporting builds must disclose the hosting region and server retention policy." />
  </Target>
</Project>
